def _gpu_all_stats():
    """Query all 3 GPUs: VRAM, util, temp. Returns list of dicts keyed by UUID."""
    gpus = [(g["uuid"], g.get("label", name), "primary" if name == PRIMARY_GPU else name)
            for name, g in GPUS.items()]
    results = []
    try:
        r = subprocess.run(
            ["nvidia-smi",
             "--query-gpu=uuid,name,memory.used,memory.total,memory.free,utilization.gpu,temperature.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=10,
        )
        if r.returncode != 0:
            return None
        rows = {}
        for line in r.stdout.strip().split("\n"):
            parts = [p.strip() for p in line.split(",")]
            if len(parts) >= 7:
                rows[parts[0]] = parts[1:]
    except Exception:
        return None

    for uuid, label, role in gpus:
        row = rows.get(uuid)
        if not row:
            results.append({"uuid": uuid, "role": role, "name": label, "error": "not found"})
            continue
        results.append({
            "uuid": uuid, "role": role, "name": row[0],
            "vram_used_mb": int(row[1]), "vram_total_mb": int(row[2]),
            "vram_free_mb": int(row[3]), "utilization_pct": int(row[4]),
            "temperature_c": int(row[5]),
        })
    return results


def _gpu_compute_apps():
    """Per-process GPU VRAM via nvidia-smi. Returns list of {gpu_uuid, pid, name, vram_mb}."""
    try:
        r = subprocess.run(
            ["nvidia-smi",
             "--query-compute-apps=gpu_uuid,pid,process_name,used_gpu_memory",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=10,
        )
        if r.returncode != 0:
            return []
        apps = []
        for line in r.stdout.strip().split("\n"):
            if not line.strip():
                continue
            parts = [p.strip() for p in line.split(",")]
            if len(parts) >= 4:
                apps.append({
                    "gpu_uuid": parts[0], "pid": int(parts[1]),
                    "process": parts[2], "vram_mb": int(parts[3]),
                })
        return apps
    except Exception:
        return []


# Known service detection by PID: the engines model-swap runs, then the rig's
# own services from config `known_services:` (first substring match wins).
_KNOWN_SERVICE_PATTERNS = {
    "llama-server": "llama",
    "vllm": "vllm",
    "ds4-server": "ds4",
    **{str(k): str(v) for k, v in (CFG.get("known_services") or {}).items()},
}
_KNOWN_SERVICE_PID_FILES = {str(k): str(v) for k, v in
                            (CFG.get("known_service_pid_files") or {}).items()}


def _identify_process(pid, process_name):
    """Match a GPU process PID to a known service. Returns service name or 'unknown'."""
    pname_lower = process_name.lower()
    for pattern, service in _KNOWN_SERVICE_PATTERNS.items():
        if pattern in pname_lower:
            return service
    # Fall back: read /proc/PID/cmdline for deeper match
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().decode("utf-8", errors="replace").replace("\0", " ")
        cmdline_lower = cmdline.lower()
        for pattern, service in _KNOWN_SERVICE_PATTERNS.items():
            if pattern in cmdline_lower:
                return service
        # Check known PID files
        for svc, pid_path in _KNOWN_SERVICE_PID_FILES.items():
            if Path(pid_path).exists():
                try:
                    if int(Path(pid_path).read_text().strip()) == pid:
                        return svc
                except (ValueError, OSError):
                    pass
        # Check slot PIDs
        for name, slot in ALL_SLOTS.items():
            if slot["pid_file"].exists():
                try:
                    if int(slot["pid_file"].read_text().strip()) == pid:
                        return f"slot:{name}"
                except (ValueError, OSError):
                    pass
    except (OSError, PermissionError):
        pass
    return "unknown"


def cmd_gpu(args):
    gpu_stats = _gpu_all_stats()
    if not gpu_stats:
        error("Could not query GPU stats")
        return 1

    apps = _gpu_compute_apps()
    # Identify each process
    for app in apps:
        app["service"] = _identify_process(app["pid"], app["process"])

    # Group apps by GPU
    apps_by_gpu = {}
    for app in apps:
        apps_by_gpu.setdefault(app["gpu_uuid"], []).append(app)

    # Lease / reservation state
    lease = _lease_contract()
    reservation = None
    if RESERVATION_FILE.exists():
        try:
            with open(RESERVATION_FILE) as f:
                reservation = json.load(f)
        except Exception:
            pass

    rogues = [a for a in apps if a["service"] == "unknown"]

    if _json_mode:
        json_out({
            "gpus": gpu_stats,
            "processes": apps,
            "lease": lease,
            "reservation": reservation,
            "rogues": rogues,
            "clean": len(rogues) == 0,
        })
        return 0

    # Human-readable output
    for gpu in gpu_stats:
        if gpu.get("error"):
            info(f"{gpu['role']:>10}  {gpu['name']}  — {gpu['error']}")
            continue
        used_pct = round(gpu["vram_used_mb"] / gpu["vram_total_mb"] * 100)
        info(f"{gpu['role']:>10}  {gpu['name']}  "
             f"{gpu['vram_used_mb']:>5}/{gpu['vram_total_mb']}MiB ({used_pct:>2}%)  "
             f"util {gpu['utilization_pct']}%  {gpu['temperature_c']}°C")
        gpu_apps = apps_by_gpu.get(gpu["uuid"], [])
        for app in gpu_apps:
            tag = app["service"]
            flag = " ⚠ ROGUE" if tag == "unknown" else ""
            info(f"{'':>10}  └─ {tag} (pid {app['pid']}) {app['vram_mb']}MiB{flag}")

    if lease:
        info(f"     lease  {lease['holder']} on {len(lease.get('devices', []))} GPU(s) ({lease.get('age_s', '?')}s ago)")
    if reservation:
        info(f"   reserve  {reservation.get('reason')} on {reservation.get('devices')}")
    if rogues:
        info(f"  ⚠ {len(rogues)} unmanaged process(es) on GPU — use nvidia-smi or kill to investigate")
    else:
        info(f"     clean  ✓ all GPU processes managed by model-swap")
    return 0


def cmd_ps(args):
    pid, cmdline = find_server_process()
    if pid is None:
        if _json_mode:
            json_out({"running": False})
        else:
            info(f"No inference server running on port {PORT}")
        return 0

    # Get process uptime
    uptime = None
    try:
        with open(f"/proc/{pid}/stat") as f:
            stat_fields = f.read().split()
        start_ticks = int(stat_fields[21])
        with open("/proc/uptime") as f:
            system_uptime = float(f.read().split()[0])
        clk_tck = os.sysconf(os.sysconf_names["SC_CLK_TCK"])
        proc_uptime_s = system_uptime - (start_ticks / clk_tck)
        hours = int(proc_uptime_s // 3600)
        mins = int((proc_uptime_s % 3600) // 60)
        uptime = f"{hours}h{mins}m"
    except Exception:
        pass

    if _json_mode:
        json_out({"running": True, "pid": pid, "cmdline": cmdline, "uptime": uptime})
    else:
        info(f"PID: {pid}")
        if uptime:
            info(f"Uptime: {uptime}")
        info(f"Command: {cmdline}")
    return 0


