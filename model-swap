        error("no `secondary` slot in the config")
        return 2
    args.slot, args.action = "secondary", "ensure"
    return cmd_slot(args)


def cmd_secondary_stop(args):
    """Stop the secondary-slot llama-server."""
    if not SLOT_SECONDARY:
        error("no `secondary` slot in the config")
        return 2
    killed, msg = stop_secondary()
    info(f"{SECONDARY_ALIAS}: {msg}")
    if _json_mode:
        json_out({"status": "stopped", "device": SECONDARY_ALIAS, "message": msg})
    return 0


def cmd_secondary_status(args):
    """Show secondary-slot server status."""
    if not SLOT_SECONDARY:
        error("no `secondary` slot in the config")
        return 2
    ok, health_text = check_secondary_health()
    pid, _ = find_secondary_process()

    if _json_mode:
        json_out({
            "device": SECONDARY_ALIAS,
            "running": ok,
            "healthy": ok,
            "pid": pid,
        })
        return 0

    if ok:
        info(f"{SECONDARY_ALIAS}: running (healthy, PID {pid})")
        # Show idle info
        if SLOT_SECONDARY["activity"].exists():
            try:
                last = int(SLOT_SECONDARY["activity"].read_text().strip())
                idle = int(time.time()) - last
                info(f"  Idle: {idle}s / {SLOT_SECONDARY['idle_timeout']}s")
            except (ValueError, OSError):
                pass
    else:
        info(f"{SECONDARY_ALIAS}: stopped")

    # Show the secondary card's GPU stats
    try:
        result = subprocess.run(
            ["nvidia-smi",
             "--query-gpu=memory.used,memory.total,memory.free,temperature.gpu",
             "--format=csv,noheader,nounits",
             f"--id={SLOT_SECONDARY['uuid']}"],
            capture_output=True, text=True, timeout=10,
        )
        parts = [p.strip() for p in result.stdout.strip().split(",")]
        if len(parts) >= 4:
            info(f"  VRAM: {parts[0]}MiB / {parts[1]}MiB ({parts[2]}MiB free)")
            info(f"  Temperature: {parts[3]}\u00b0C")
    except Exception:
        pass
    return 0


def cmd_slot(args):
    """Generic slot command: ensure | stop | status for any configured slot."""
    slot = ALL_SLOTS[args.slot]
    action = args.action

    if action == "ensure":
        explicit = bool(getattr(args, "gguf", None) or getattr(args, "profile", None))
        if not explicit and slot["last"].exists():
            # Bare ensure = the gateway's wake-on-request: reload what was last
            # asked for on this slot, not slot_default_gguf (mirrors the
            # primary's .active.json priority).
            try:
                last = json.loads(slot["last"].read_text())
                args.profile, args.gguf = last.get("profile"), last.get("gguf")
                args.ctx = getattr(args, "ctx", None) or last.get("ctx")
            except (OSError, ValueError):
                pass
        gguf = Path(args.gguf) if getattr(args, "gguf", None) else None
        ctx = getattr(args, "ctx", None) or 32768
        # --profile resolves a named profile to gguf+ctx, so wrappers
        # don't need to duplicate profile resolution logic
        profile_name = getattr(args, "profile", None)
        if profile_name:
            profile, err = load_profile(profile_name)
            if err:
                error(err)
                return 4
            if _detect_backend(profile) != "llama":
                error(f"Profile '{profile_name}' is backend "
                      f"'{_detect_backend(profile)}' — slots run llama-server only")
                return 4
            gguf_resolved = resolve_model_path(profile)
            if not gguf_resolved:
                error(f"Model file not found for profile '{profile_name}': {profile['model']}")
                return 4
            gguf = gguf_resolved
            # explicit --ctx wins over the profile's ctx_size (it used to lose,
            # making `slot ... --profile X --ctx N` silently run at profile ctx)
            ctx = getattr(args, "ctx", None) or profile.get("params", {}).get("ctx_size", 32768)
            info(f"Profile '{profile_name}': {Path(gguf).name}, ctx={ctx}")
        _pea = profile.get("extra_args") if profile_name else None
        _bin = resolve_binary(profile) if profile_name else None
        _pp = profile.get("params") if profile_name else None
        # --dry-run used to be silently ignored here, so a dry-run `ensure` of a
        # pool spanning the primary really stopped the primary. Honor it.
        if getattr(args, "dry_run", False):
            plan = {"slot": slot["name"], "port": slot.get("port"),
                    "gguf": str(gguf) if gguf else None, "ctx": ctx,
                    "binary": str(_bin) if _bin else None,
                    "would_stop_primary": GPU_UUID in slot["cuda_devices"].split(",")}
            if _json_mode:
                json_out({"dry_run": True, **plan})
            else:
                info("DRY RUN — no GPU state changed:")
                for k, v in plan.items():
                    info(f"  {k}: {v}")
            return 0
        ok, msg = slot_ensure(slot, gguf, ctx, profile_extra_args=_pea, binary=_bin,
                              profile_params=_pp,
                              idle_timeout=getattr(args, "idle_timeout", None))
        if ok and explicit:
            slot["last"].write_text(json.dumps(
                {"profile": profile_name, "gguf": None if profile_name else str(gguf),
                 "ctx": getattr(args, "ctx", None)}))
        if _json_mode:
            json_out({"slot": slot["name"], "status": "ready" if ok else "failed", "message": msg})
        else:
            (info if ok else error)(f"{slot['name']}: {msg}")
        return 0 if ok else 1

    if action == "stop":
        killed, msg = slot_stop(slot)
        if _json_mode:
            json_out({"slot": slot["name"], "status": "stopped", "message": msg})
        else:
            info(f"{slot['name']}: {msg}")
        return 0

    # status
    ok, _ = slot_check_health(slot)
    pid, _ = slot_find_process(slot)
    if _json_mode:
        json_out({"slot": slot["name"], "port": slot["port"],
                  "running": ok, "healthy": ok, "pid": pid})
        return 0
    info(f"{slot['name']}: {'running (healthy, PID %d)' % pid if ok else 'stopped'}")
    if ok and slot["activity"].exists():
        try:
            idle = int(time.time()) - int(slot["activity"].read_text().strip())
            info(f"  Idle: {idle}s / {slot['idle_timeout']}s")
        except (ValueError, OSError):
            pass
    # GPU stats — a pool spans several cards, a single-card slot queries one UUID
    query = ["nvidia-smi", "--query-gpu=memory.used,memory.total,memory.free,temperature.gpu",
             "--format=csv,noheader,nounits"]
    if slot["uuid"]:
        query.append(f"--id={slot['uuid']}")
    else:
        query.append(f"--id={slot['cuda_devices']}")  # pool: one row per card
    try:
        result = subprocess.run(query, capture_output=True, text=True, timeout=10)
        for row in result.stdout.strip().splitlines():
            parts = [p.strip() for p in row.split(",")]
            if len(parts) >= 4:
                info(f"  VRAM: {parts[0]}MiB / {parts[1]}MiB ({parts[2]}MiB free)  {parts[3]}°C")
    except Exception:
        pass
    return 0


def cmd_ensure(args):
    """Ensure llama-server is running. Start if needed, noop if healthy."""
    # Handle --device <secondary alias>
    device = getattr(args, "device", None)
    if device == SECONDARY_ALIAS:
        return cmd_secondary_ensure(args)

    # Already running and healthy?
    ok, _ = check_health(timeout_s=2)
    if ok:
        cur = get_current_state()
        profile_name = cur.get("profile") or "unknown"
        if not _quiet_mode:
            info(f"Server healthy (profile: {profile_name}, PID: {cur['pid']})")
        if _json_mode:
            json_out({"status": "already_running", "profile": profile_name, "pid": cur["pid"]})
        return 0

    # A load in progress (e.g. ds4's multi-minute engine open) looks unhealthy
    # here — do NOT "recover" by loading over it. Back off; it has a watchdog
    # of its own (wait_for_health + process_died fast-fail).
    lock = _read_load_lock()
    if lock:
        if not _quiet_mode:
            info(f"Load in progress (pid {lock['pid']}, profile {lock.get('profile')}) — not interfering")
        if _json_mode:
            json_out({"status": "load_in_progress", "profile": lock.get("profile"), "pid": lock["pid"]})
        return 0

    # Primary not running — but a slot might be serving. Don't evict it.
    # ensure means "make sure SOMETHING is serving", not "force the primary"
    for _sname, _slot in ALL_SLOTS.items():
        _sok, _ = slot_check_health(_slot, timeout_s=2)
        if _sok:
            if not _quiet_mode:
                info(f"Slot {_slot['name']} is serving on :{_slot['port']} — skipping primary ensure")
            if _json_mode:
                json_out({"status": "slot_serving", "slot": _slot["name"], "port": _slot["port"]})
            return 0

    # A live FreeToken borrow serves its own model on its own port; the gateway
    # routes the served name through the contract models entry the load path wrote
    # (lock-ordered before this check can see the state file). It IS the ready
    # LLM — don't stack a primary on the borrowed card.
    ft = _ft_state()
    if ft:
        # Same probe as the load path: a live process with a bound port is not a
        # ready LLM. If the engine is gone, fall through and load a real one
        # rather than telling the launcher everything is fine.
        ft_ok = _ft_serving(ft.get("port", FT_PORT), ft.get("served_name"))
        if ft_ok:
            if not _quiet_mode:
                info(f"FreeToken serving {ft.get('served_name')} on :{ft.get('port', FT_PORT)}"
                     f" — published in the contract models map (borrow active)")
            if _json_mode:
                json_out({"status": "freetoken_serving", "model": ft.get("served_name"),
                          "port": ft.get("port", FT_PORT)})
            return 0

    # Nothing running — determine which profile to load
    # Priority: 1) CLI --profile, 2) state file (last loaded), 3) DEFAULT_PROFILE
    profile_name = getattr(args, "ensure_profile", None)

    if not profile_name and STATE_FILE.exists():
        try:
            with open(STATE_FILE) as f:
                saved = json.load(f)
            profile_name = saved.get("profile")
            verbose(f"Resuming last profile from state: {profile_name}")
        except Exception:
            pass

    if not profile_name:
        profile_name = DEFAULT_PROFILE
        if not profile_name:
            error("Nothing to load: no last-used profile, no --profile, and no "
                  "primary.default_profile in the config")
            return 4
        verbose(f"Using default profile: {profile_name}")

    # Delegate to cmd_load
    info(f"Server not running — loading {profile_name}")
    args.profile = profile_name
    return cmd_load(args)


# ── GPU lease — one hold mechanism for EVERY device ───────────
# A lease names a holder, covers a set of devices, and carries a TTL. Any
# consumer (image generation, a bench run, a training job) acquires before it
# touches a card and releases when done. model-swap enforces it: starting a
# server on a device another holder leases is denied, and the idle watchdogs
# treat a live lease as activity (so a long job is not idle-killed). The lease
# expires if not renewed, so a crashed holder never blocks a card forever, and
# model-swap stays the sole writer of GPU state.
LEASE_FILE = MODELS_DIR / ".gpu-lease.json"
LEASE_TTL_S = 90          # stale if not renewed within this window
LEASE_RENEW_INTERVAL_S = 30   # recommended heartbeat cadence — comfortably < TTL
SLOT_BUSY_WINDOW_S = 60   # a slot is "serving" if touched within this window
LEASE_DEFAULT_DEVICES = [str(d) for d in CFG.get("lease_default_devices") or ["all"]]

# Lease device vocabulary → concrete GPU UUIDs. Covers every device, not just
# one pool: the primary card and pools spanning it included.
def _build_lease_device_map():
    """Lease/reserve device vocabulary: every GPU name, `primary`, every slot's
    name, `all`, plus `device_aliases:` from the config."""
    m = {name: [g["uuid"]] for name, g in GPUS.items()}
    m["primary"] = [GPU_UUID]
    for sl in ALL_SLOTS.values():
        m[sl["name"]] = sl["cuda_devices"].split(",")
    m["all"] = [g["uuid"] for g in GPUS.values()]
    for alias, names in (CFG.get("device_aliases") or {}).items():
        m[str(alias)] = [GPUS[str(n)]["uuid"] for n in names]
    return m


_LEASE_DEVICE_MAP = _build_lease_device_map()


def _lease_devices(names):
    """Resolve lease device vocabulary to a set of GPU UUIDs."""
    uuids = set()
    for n in names:
        uuids.update(_LEASE_DEVICE_MAP.get(n, [n]))  # pass UUIDs through verbatim
    return uuids


def _self_holder():
    """Holder identity of THIS process, if it already owns a lease.

    A holder that leased a device must still be able to load on it; the env var
    is how a leasing run (e.g. a benchmark harness) tells its own model-swap calls who
    they are."""
    return os.environ.get("MODEL_SWAP_LEASE_HOLDER") or None


def _lease_read():
    """Return the active lease dict, or None if missing/expired. Expiry is the
    backstop: a holder that stops renewing frees its devices automatically."""
    if not LEASE_FILE.exists():
        return None
    try:
        with open(LEASE_FILE) as f:
            lease = json.load(f)
        age = time.time() - float(lease.get("last_renew", 0))
        ttl = float(lease.get("ttl_s", LEASE_TTL_S))
        if age > ttl:
            return None
        lease["_age_s"] = int(age)
        lease["_ttl_remaining_s"] = int(ttl - age)
        return lease
    except Exception:
        return None


def _lease_covers(slot):
    """The live lease covering any of slot's GPUs, regardless of holder, or None."""
    lease = _lease_read()
    if not lease:
        return None
    slot_devs = set(str(slot["cuda_devices"]).split(","))
    if set(lease.get("devices", [])) & slot_devs:
        return lease
    return None


def _lease_conflict(slot, holder=None):
    """If ANOTHER holder's live lease covers slot's GPUs, return {holder, fresh_s}.

    `holder` (defaulting to this process's identity) is not blocked by its own
    lease — otherwise a run could never load on the device it just acquired."""
    lease = _lease_covers(slot)
    if not lease:
        return None
    me = holder or _self_holder()
    if me and lease.get("holder") == me:
        return None
    return {"holder": lease.get("holder", "unknown"), "fresh_s": lease.get("_age_s", 0),
            "ttl_remaining_s": lease.get("_ttl_remaining_s", 0)}


def _slot_busy(slot):
    """True if the slot is running AND actively served within SLOT_BUSY_WINDOW_S."""
    if not slot["state"].exists():
        return False
    try:
        ts = int(slot["activity"].read_text().strip())
        return (time.time() - ts) < SLOT_BUSY_WINDOW_S
    except (ValueError, OSError):
        # Running but no fresh activity stamp — treat as idle (evictable).
        return False


class _NoneDict(dict):
    def __missing__(self, key):
        return None


def _sidecar_contract(sc):
    """Contract entry for a config `sidecars:` service — reported only, never
    started or stopped here. Up = its probe path answers on 127.0.0.1:<port>.
    `from_health` formats fields out of the probe's JSON body, `pid_file` reads
    a pid, `report_lease` adds whether a GPU lease is live."""
    fields = sc.get("from_health") or {}
    entry = {"port": sc["port"], "state": "stopped", **{k: None for k in fields}}
    if sc.get("pid_file"):
        entry["pid"] = None
    try:
        req = Request(f"http://127.0.0.1:{sc['port']}{sc.get('probe', '/')}")
        with urlopen(req, timeout=sc.get("probe_timeout", 2)) as resp:
            body = resp.read()
            if resp.status != 200:
                raise ValueError(resp.status)
        if fields:
            j, vals = json.loads(body), {}
            for k, f in fields.items():
                m = re.fullmatch(r"\{(\w+)\}", f)  # a bare "{key}" keeps the raw JSON value
                vals[k] = j.get(m.group(1)) if m else f.format_map(_NoneDict(j))
            entry.update(vals)
        entry["state"] = "running"
        if sc.get("pid_file") and Path(sc["pid_file"]).exists():
            entry["pid"] = int(Path(sc["pid_file"]).read_text().strip())
    except Exception:
        pass
    if sc.get("report_lease"):
        entry["leased"] = bool(_lease_read())
    entry["note"] = sc.get("note")
    return entry


def _lease_contract():
    """Lease state for the contract, or None when no live lease."""
    lease = _lease_read()
    if not lease:
        return None
    return {
        "holder": lease.get("holder", "unknown"),
        "devices": lease.get("devices", []),
        "device_names": lease.get("device_names", []),
        "age_s": lease.get("_age_s", 0),
        "ttl_s": lease.get("ttl_s", LEASE_TTL_S),
        "ttl_remaining_s": lease.get("_ttl_remaining_s", 0),
        "acquired_at": lease.get("acquired_at"),
        "pid": lease.get("pid"),
    }


def _dry_out(action, plan):
    """Report a lease action that was NOT performed. Mirrors the `slot` command's
    dry-run shape: {"dry_run": true, ...} under --json, an indented plan otherwise."""
    if _json_mode:
        json_out({"dry_run": True, "action": action, **plan})
    else:
        info(f"DRY RUN — lease {action} not performed, no GPU state changed:")
        for k, v in plan.items():
            info(f"  {k}: {v}")


def cmd_lease(args):
    """Acquire/renew/release/status a GPU lease on any device.

    acquire: requires --holder; denies if another holder's live lease overlaps
             the requested devices. Evicts *idle* conflicting llama slots; DENIES
             if one is actively serving (unless --force). Then writes the lease.
    renew:   bump the heartbeat (cheap, no contract rewrite) — the supported way
             to hold a device across a long job.
    release: drop the lease, free the devices. Call this in a `finally`.
    status:  holder, devices, age, TTL remaining.

    --dry-run is honored by every mutating action. It used to be silently
    ignored, so `lease acquire --dry-run` really took the lease *and* ran the
    eviction path — it could stop a serving slot or kill the primary server.
    Checks still run (so a dry run reports a genuine deny), nothing is written.
    """
    action = args.lease_action
    dry = getattr(args, "dry_run", False)

    if action == "status":
        lease = _lease_read()
        if _json_mode:
            json_out({"lease": _lease_contract()})
        elif lease:
            names = lease.get("device_names") or lease.get("devices", [])
            info(f"Lease held by '{lease.get('holder')}' on {names} "
                 f"— age {lease['_age_s']}s, ttl {lease.get('ttl_s', LEASE_TTL_S)}s, "
                 f"{lease.get('_ttl_remaining_s', 0)}s remaining")
        else:
            info("No active lease")
        return 0

    if action == "renew":
        if not LEASE_FILE.exists():
            error("No lease to renew (acquire first)")
            return 1
        lease = _lease_read()
        if lease is None:
            # Expired leases are NOT resurrected: the TTL backstop already handed
            # the devices back, so the holder must re-acquire (and re-evict).
            error("No live lease to renew (expired or never acquired) — acquire first")
            return 1
        if args.holder and lease.get("holder") != args.holder:
            error(f"Lease is held by '{lease.get('holder')}', not '{args.holder}' — refusing renew")
            return 1
        if dry:
            _dry_out("renew", {"holder": lease.get("holder"),
                               "ttl_s": args.lease_ttl or lease.get("ttl_s", LEASE_TTL_S)})
            return 0
        try:
            lease.pop("_age_s", None)
            lease.pop("_ttl_remaining_s", None)
            lease["last_renew"] = time.time()
            if args.lease_ttl:
                lease["ttl_s"] = args.lease_ttl
            with open(LEASE_FILE, "w") as f:
                json.dump(lease, f, indent=2)
        except Exception as e:
            error(f"Renew failed: {e}")
            return 1
        if _json_mode:
            json_out({"status": "renewed", "holder": lease.get("holder"),
                      "ttl_s": lease.get("ttl_s", LEASE_TTL_S)})
        return 0

    if action == "release":
        live = _lease_read()
        if (live and args.holder and live.get("holder") != args.holder
                and not args.force):
            error(f"Lease is held by '{live.get('holder')}', not '{args.holder}' "
                  "— refusing release (use --force)")
            if _json_mode:
                json_out({"status": "denied", "holder": live.get("holder")})
            return 1
        existed = LEASE_FILE.exists()
        if dry:
            _dry_out("release", {"had_lease": existed,
                                 "holder": (live or {}).get("holder")})
            return 0
        LEASE_FILE.unlink(missing_ok=True)
        write_contract()
        info("Lease released" if existed else "No active lease")
        if _json_mode:
            json_out({"status": "released", "had_lease": existed})
        return 0

    # acquire — holder identity is REQUIRED (an acquire always names a holder).
    holder = args.holder
    if not holder:
        error("acquire requires --holder <name> (no default identity)")
        if _json_mode:
            json_out({"status": "denied", "reason": "no holder"})
        return 1
    device_names = args.devices or LEASE_DEFAULT_DEVICES
    target = _lease_devices(device_names)

    # Another holder's live lease over any requested device denies acquisition.
    existing = _lease_read()
    if (existing and existing.get("holder") != holder
            and set(existing.get("devices", [])) & target and not args.force):
        error(f"Devices already leased by '{existing.get('holder')}' "
              f"({existing.get('_ttl_remaining_s', 0)}s TTL remaining) — denied "
              "(wait, or --force)")
        if _json_mode:
            json_out({"status": "denied", "held_by": existing.get("holder"),
                      "ttl_remaining_s": existing.get("_ttl_remaining_s", 0)})
        return 1

    evicted, blocked = [], []
    # Re-acquiring as the SAME holder extends an existing hold (e.g. a run adding
    # a second device); it must never evict the holder's own running servers.
    same_holder = bool(existing) and existing.get("holder") == holder
    for name, slot in ALL_SLOTS.items():
        if same_holder:
            break
        if not (set(slot["cuda_devices"].split(",")) & target):
            continue
        if not slot["state"].exists():
            continue  # not running as itself
        if _slot_busy(slot) and not args.force:
            blocked.append(slot["name"])
        else:
            if not dry:
                slot_stop(slot)
            evicted.append(slot["name"])

    # The primary server isn't a slot — handle it when the lease wants the primary card.
    # No busy-stamp exists for it, so be conservative: deny unless --force.
    if GPU_UUID in target and not same_holder:
        cur = get_current_state()
        if cur["running"]:
            if args.force:
                if dry:
                    info(f"[dry-run] Would stop primary {PRIMARY_GPU} server (PID {cur['pid']}) for lease")
                else:
                    info(f"Stopping primary {PRIMARY_GPU} server (PID {cur['pid']}) for lease...")
                    kill_server(cur["pid"])
                    write_contract()
                evicted.append(f"primary-{PRIMARY_GPU}")
            else:
                blocked.append(f"primary-{PRIMARY_GPU}")

    if blocked:
        error(f"Slot(s) busy serving: {', '.join(blocked)} — denied (use --force to override)")
        if _json_mode:
            json_out({"status": "denied", "busy": blocked})
        return 1

    if same_holder:
        # Extend, never shrink: a holder acquiring a second device keeps the first.
        target |= set(existing.get("devices", []))
        device_names = sorted(set(device_names) | set(existing.get("device_names", [])))
    ttl = args.lease_ttl or LEASE_TTL_S
    now = time.time()
    lease = {
        "holder": holder,
        "devices": sorted(target),
        "device_names": list(device_names),
        "acquired_at": now,
        "last_renew": now,
        "ttl_s": ttl,
        "pid": os.getpid(),
    }
    if dry:
        _dry_out("acquire", {"holder": holder, "devices": sorted(target),
                             "device_names": list(device_names), "ttl_s": ttl,
                             "would_evict": evicted})
        return 0
    with open(LEASE_FILE, "w") as f:
        json.dump(lease, f, indent=2)
    write_contract()
    info(f"Lease acquired by '{holder}' on {len(target)} GPU(s) {device_names}, ttl {ttl}s"
         + (f" (evicted: {', '.join(evicted)})" if evicted else ""))
    if _json_mode:
        json_out({"status": "acquired", "holder": holder, "devices": sorted(target),
                  "ttl_s": ttl, "evicted": evicted})
    return 0


# ── GPU Reservation (exclusive access for a non-model-swap job) ────────────

RESERVATION_FILE = MODELS_DIR / ".reservation.json"


def _read_reservation():
    """The reservation dict, or None when there is no readable one. Read-only:
    unlike _ft_state() this never deletes what it inspects."""
    if not RESERVATION_FILE.exists():
        return None
    try:
        with open(RESERVATION_FILE) as f:
            return json.load(f)
    except Exception:
        return None


def do_reserve(devices, reason, timeout, extra_stopped=None):
    """Core of `reserve`: refuse if a live reservation exists, stop inference
    on the requested devices (snapshotting what was stopped), write the
    reservation + contract. extra_stopped: caller-stopped entries merged into
    the snapshot (e.g. a slot evicted by a freetoken load before the
    reservation was taken). Returns (rc, reservation_dict)."""
    # Check for existing reservation (auto-clear if expired)
    if RESERVATION_FILE.exists():
        try:
            with open(RESERVATION_FILE) as f:
                existing = json.load(f)
            ts = existing.get("timestamp", "")
            timeout_s = existing.get("timeout_s", 3600)
            try:
                from datetime import datetime as _dt
                created = _dt.strptime(ts, "%Y-%m-%dT%H:%M:%S")
                age = (_dt.now() - created).total_seconds()
                if age > timeout_s:
                    info(f"Auto-clearing expired reservation (age {age:.0f}s > timeout {timeout_s}s, reason: {existing.get('reason')})")
                    RESERVATION_FILE.unlink(missing_ok=True)
                else:
                    error(f"GPU already reserved by '{existing.get('reason')}' since {ts} ({age:.0f}s ago, expires in {timeout_s - age:.0f}s)")
                    error(f"Release with: model-swap release")
                    return 1, None
            except ValueError:
                error(f"GPU already reserved by '{existing.get('reason')}' since {ts}")
                error(f"Release with: model-swap release")
                return 1, None
        except Exception:
            pass

    stopped = {}

    # Stop inference on requested devices
    if PRIMARY_GPU in devices:
        lock = _read_load_lock()
        if lock and lock.get("pid") != os.getpid():
            error(f"Load in progress (pid {lock['pid']}, profile {lock.get('profile')}) "
                  f"— its retry loop would resurrect the server on the reserved GPU. Retry after it finishes.")
            return 6, None
        cur = get_current_state()
        if cur["running"]:
            info(f"Stopping {PRIMARY_GPU} (profile: {cur.get('profile')})...")
            _kill_idle_watchdog()  # Kill before server — prevent watchdog/contract race
            kill_server(cur["pid"])
            stopped[PRIMARY_GPU] = cur.get("profile")

    if SECONDARY_ALIAS in devices and SLOT_SECONDARY:
        pid, _ = find_secondary_process()
        if pid:
            info(f"Stopping {SECONDARY_ALIAS}...")
            stop_secondary()
            stopped[SECONDARY_ALIAS] = True

    if extra_stopped:
        stopped.update(extra_stopped)

    # Write reservation
    reservation = {
        "reason": reason,
        "devices": devices,
        "timeout_s": timeout,
        "stopped_profiles": stopped,
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "pid": os.getpid(),
    }
    with open(RESERVATION_FILE, "w") as f:
        json.dump(reservation, f, indent=2)

    write_contract()
    info(f"Reserved: {', '.join(devices)} for '{reason}' (timeout: {timeout}s)")
    return 0, reservation


def cmd_reserve(args):
    """Reserve GPU(s) for exclusive use. Stops inference servers, writes reservation."""
    rc, reservation = do_reserve(args.devices or [PRIMARY_GPU], args.reason or "manual",
                                 args.reserve_timeout or 3600)
    if rc != 0:
        return rc
    if _json_mode:
        json_out({"status": "reserved", **reservation})
    return 0


def do_release(no_restore=False):
    """Core of `release`: clear the reservation and (unless no_restore) restore
    the snapshotted profiles on the reserved devices. Returns (rc, restored)."""
    if not RESERVATION_FILE.exists():
        info("No active reservation")
        return 0, []

    try:
        with open(RESERVATION_FILE) as f:
            reservation = json.load(f)
    except Exception:
        reservation = {}

    # Expired reservation = its "stopped profiles" snapshot is ancient history.
    # Restoring it would launch a model nobody asked for (e.g. a 4-day-stale
    # qwable over a live ds4). Clear the file, skip the restore.
    res_expired = False
    try:
        res_age = time.time() - time.mktime(
            time.strptime(reservation.get("timestamp", ""), "%Y-%m-%dT%H:%M:%S"))
        res_expired = res_age > reservation.get("timeout_s", 3600)
    except Exception:
        res_expired = True  # unparseable = don't trust its restore snapshot

    # Clean up reservation
    RESERVATION_FILE.unlink(missing_ok=True)

    # Restore previous profiles if requested
    restored = []
    stopped = reservation.get("stopped_profiles", {})

    if res_expired and not no_restore:
        info("Reservation expired — skipping profile restore (load manually if wanted)")
    if not no_restore and not res_expired:
        if stopped.get(PRIMARY_GPU):
            profile_name = stopped[PRIMARY_GPU]
            if get_current_state()["running"]:
                info(f"{PRIMARY_GPU} already serving — skipping restore of {profile_name}")
            elif not _acquire_load_lock(profile_name, ttl_s=DS4_DEFAULT_TIMEOUT + 300):
                error(f"Load in progress — skipping {PRIMARY_GPU} restore")
            else:
                try:
                    info(f"Restoring {PRIMARY_GPU} profile: {profile_name}")
                    profile, err = load_profile(profile_name)
                    if profile:
                        r_backend = _detect_backend(profile)
                        # No freetoken entry: a borrow never lands in a restore
                        # snapshot (do_reserve refuses while a reservation is
                        # live, so nothing can reserve over a live borrow), and
                        # the restore below launches without the borrow's
                        # CUDA_VISIBLE_DEVICES/port and would probe 8012.
                        r_timeout = {"vllm": VLLM_DEFAULT_TIMEOUT,
                                     "ds4": DS4_DEFAULT_TIMEOUT}.get(r_backend, 30)
                        pid, _ = start_server(profile)
                        healthy, elapsed, reason = wait_for_health(timeout_s=r_timeout, pid=pid)
                        if healthy:
                            save_state(profile_name, profile["model"], pid, backend=r_backend)
                            restored.append(f"{PRIMARY_GPU}:{profile_name}")
                        else:
                            error(f"{PRIMARY_GPU} restore failed ({reason} after {elapsed}s)")
                finally:
                    _release_load_lock()

        if SECONDARY_ALIAS in stopped and SLOT_SECONDARY:
            info(f"Restoring {SECONDARY_ALIAS}...")
            if cmd_slot(argparse.Namespace(slot="secondary", action="ensure")) == 0:
                restored.append(SECONDARY_ALIAS)
            else:
                error(f"{SECONDARY_ALIAS} restore failed")

    write_contract()
    info(f"Released. Restored: {', '.join(restored) or 'none'}")
    return 0, restored


def cmd_release(args):
    """Release GPU reservation and optionally restore previous profiles."""
    rc, restored = do_release(no_restore=args.no_restore)
    if _json_mode:
        json_out({"status": "released", "restored": restored})
    return rc


# ── HuggingFace download proxy ───────────────────────────────────────────────

HF_DEFAULT_RATE_MBPS = 2000  # Mbps cap; curl single-stream won't saturate the link like hf-cli


def _hf_api_get(path: str) -> dict | None:
    """GET from HF API."""
    import json as _json
    url = f"https://huggingface.co{path}"
    try:
        r = subprocess.run(
            ["curl", "-sf", "--connect-timeout", "10", url],
            capture_output=True, text=True, timeout=20,
        )
        if r.returncode == 0 and r.stdout.strip():
            return _json.loads(r.stdout)
    except Exception:
        pass
    return None


_HF_IGNORE = ["*.gguf", "original/*", "*.pt", "*.bin"]


def _filter_ignored(all_files, patterns=None):
    """Drop repo files matching the ignore globs (same list snapshot_download used)."""
    import fnmatch
    pats = patterns or _HF_IGNORE
    return [f for f in all_files
            if not any(fnmatch.fnmatch(f, p) for p in pats)]


def _has_partial(op):
    """True if a plain (non-multistream) partial download is sitting at `op`."""
    try:
        return op.exists() and op.stat().st_size > 0
    except OSError:
        return False


# Hash a whole file only when it is small enough that doing so is free; above
# this, we rely on the resume ticket (see _resume_ticket) instead of rehashing
# tens of GB on every invocation.
_CHEAP_HASH_BYTES = 64 * 1024 * 1024


def _expected_hash(sib):
    """(kind, hexdigest) the remote advertises for this file, or (None, None).

    LFS objects carry a real sha256. Plain files only carry `blobId`, which is
    the git blob sha1 — sha1("blob <len>\\0" + content) — still a content hash,
    so it detects a file that changed upstream.
    """
    lfs = (sib or {}).get("lfs") or {}
    if lfs.get("sha256"):
        return "sha256", lfs["sha256"]
    if (sib or {}).get("blobId"):
        return "git-sha1", sib["blobId"]
    return None, None


def _hash_file(path, kind):
    import hashlib
    if kind == "sha256":
        h = hashlib.sha256()
    elif kind == "git-sha1":
        h = hashlib.sha1(f"blob {path.stat().st_size}\0".encode())
    else:
        return None
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 22), b""):
            h.update(chunk)
    return h.hexdigest()


def _ticket_path(op):
    return op.with_name(op.name + ".msdl")


def _write_resume_ticket(op, want):
    """Record which remote revision a partial belongs to.

    `curl -C -` resumes by offset alone: it will happily append the tail of the
    *current* remote file onto a body from an *older* revision, producing a file
    of exactly the right length and entirely wrong content (seen on a tokenizer_config.json
    that upstream replaced between runs).
    The ticket lets the next run prove the partial belongs to the same revision
    before resuming; without a matching ticket we restart the file.
    """
    try:
        _ticket_path(op).write_text(json.dumps({"want": want}))
    except OSError:
        pass  # a missing ticket only costs a restart, never correctness


def _read_resume_ticket(op):
    try:
        return json.loads(_ticket_path(op).read_text()).get("want")
    except (OSError, ValueError):
        return None


def _clear_resume_ticket(op):
    try:
        _ticket_path(op).unlink()
    except OSError:
        pass


def _fetch_decision(op, sib, verify=False):
    """One of 'skip' | 'resume' | 'fresh' for an existing-or-absent local file.

    'resume' is only ever returned when the local bytes are provably a prefix of
    the current remote object — same size class *and* a resume ticket naming the
    same content hash. Anything unprovable degrades to 'fresh', which costs
    bandwidth but cannot corrupt.
    """
    expected = (sib or {}).get("size")
    kind, want = _expected_hash(sib)
    if not op.exists():
        return "fresh"
    try:
        have = op.stat().st_size
    except OSError:
        return "fresh"

    if expected is None:
        # No size advertised: can't reason about prefixes at all.
        return "fresh"
    if have > expected:
        return "fresh"  # longer than the target — stale or double-appended
    if have == expected:
        if want and (verify or have <= _CHEAP_HASH_BYTES):
            return "skip" if _hash_file(op, kind) == want else "fresh"
        return "skip"
    # Short file: a partial. Only resumable against the revision it came from.
    if want and _read_resume_ticket(op) == want:
        return "resume"
    return "fresh"


def _hf_curl_fetch(repo, siblings, target_files, dest_dir, parallel=1,
                   rate_kBps=250000, rate_mbps=2000, verify=False):
    """Fetch `target_files` from HF repo into `dest_dir` with curl.

    Used by every download path (GGUF, safetensors staging, --backend vllm).
    curl is not an implementation detail here — huggingface_hub >= 1.20 mints a
    uuid4 temp name and opens it "wb" on every call (file_download.py:1849), so
    a killed snapshot_download restarts from byte zero. `curl -C -` range-resumes,
    which is the only thing that makes a 50GB shard survive an interruption.

    Returns 0 on success, 1 on failure. Safe to re-run — completed files are
    skipped by size and partial files resume in place.
    """
    from concurrent.futures import ThreadPoolExecutor, as_completed

    dest_dir = Path(dest_dir)
    info(f"Rate limit: {rate_mbps} Mbps ({rate_kBps} KB/s)")
    if parallel > 1:
        info(f"Parallel streams: {parallel}")
    info(f"")

    sib_by_name = {s["rfilename"]: s for s in siblings}

    def _build_curl(tf):
        """Build curl command for a single file.

        Returns (target_file, output_path, cmd) or None if already complete.
        Resume (`-C -`) is used only when _fetch_decision proves the local bytes
        belong to the current remote revision; otherwise the file is restarted
        from zero, because an unprovable partial can silently splice revisions.
        """
        op = dest_dir / tf
        op.parent.mkdir(parents=True, exist_ok=True)  # shard subdirs
        sib = sib_by_name.get(tf)
        decision = _fetch_decision(op, sib, verify=verify)
        if decision == "skip":
            _clear_resume_ticket(op)
            return None
        _, want = _expected_hash(sib)
        if decision == "fresh":
            if op.exists():
                info(f"  {tf}: local copy is not a prefix of the current remote "
                     f"file — restarting instead of resuming")
                op.unlink()
            for stale in op.parent.glob(op.name + ".part*"):
                stale.unlink()  # multistream leftovers from another revision
        if want:
            _write_resume_ticket(op, want)
        url = f"https://huggingface.co/{repo}/resolve/main/{tf}"
        cmd = ["curl",
               "--limit-rate", f"{rate_kBps}k",
               "--connect-timeout", "15",
               "--retry", "5", "--retry-delay", "10", "--retry-connrefused",
               "-L"]
        if decision == "resume":
            cmd += ["-C", "-"]
        cmd += ["-#", "-o", str(op), url]
        return (tf, op, cmd)

    def _post_check(tf, op):
        """Verify a finished file against the remote hash. Returns True if good."""
        sib = sib_by_name.get(tf)
        kind, want = _expected_hash(sib)
        if not want:
            _clear_resume_ticket(op)
            return True
        if not (verify or op.stat().st_size <= _CHEAP_HASH_BYTES):
            _clear_resume_ticket(op)
            return True
        if _hash_file(op, kind) != want:
            error(f"  {tf}: {kind} mismatch after download — file is corrupt, "
                  f"delete it and re-run (or pass --verify to check every file)")
            return False
        _clear_resume_ticket(op)
        return True

    def _remote_size(url):
        """HEAD the resolve URL (follows redirect to CDN) → total bytes, or None."""
        r = subprocess.run(["curl", "-sIL", "--connect-timeout", "15", url],
                           capture_output=True, text=True)
        size = None
        for line in r.stdout.splitlines():
            if line.lower().startswith("content-length:"):
                size = int(line.split(":", 1)[1].strip())  # last hop = real file
        return size

    def _download_multistream(tf, op, n):
        """Dual-stream a single file via N concurrent byte-range curls, then concat.
        Per-part resume (append from existing size) + curl retries survive HF stalls."""
        import shutil
        url = f"https://huggingface.co/{repo}/resolve/main/{tf}"
        total = _remote_size(url)
        if not total:
            info("  (HEAD gave no size — falling back to single stream)")
            return subprocess.run(_build_curl(tf)[2]).returncode
        chunk = -(-total // n)  # ceil
        parts = []
        for i in range(n):
            start = i * chunk
            end = min((i + 1) * chunk, total) - 1
            if start > end:
                break
            parts.append((i, start, end, op.with_suffix(op.suffix + f".part{i}")))
        per_rate = max(1, rate_kBps // n)
        info(f"  dual-stream: {len(parts)} ranges, {total / 1e9:.2f} GB, {per_rate} KB/s/stream")

        def _dl(p):
            i, start, end, pf = p
            existing = pf.stat().st_size if pf.exists() else 0
            need = end - start + 1
            if existing >= need:
                return i, 0
            cmd = ["curl", "--limit-rate", f"{per_rate}k", "--connect-timeout", "15",
                   "--retry", "5", "--retry-delay", "10", "--retry-all-errors",
                   "--retry-connrefused", "-L", "--range", f"{start + existing}-{end}",
                   "-s", url]
            with open(pf, "ab") as fh:
                return i, subprocess.run(cmd, stdout=fh).returncode

        try:
            with ThreadPoolExecutor(max_workers=n) as pool:
                for fut in as_completed([pool.submit(_dl, p) for p in parts]):
                    i, rc = fut.result()
                    if rc != 0:
                        error(f"  stream {i} failed (curl {rc}). Re-run to resume.")
                        return 1
        except KeyboardInterrupt:
            info("\nDownload paused. Re-run to resume.")
            return 0
        for i, start, end, pf in parts:
            if pf.stat().st_size != end - start + 1:
                error(f"  part {i} size mismatch. Re-run to resume.")
                return 1
        info(f"  assembling {len(parts)} parts → {op.name}")
        with open(op, "wb") as out:
            for _, _, _, pf in parts:
                with open(pf, "rb") as fh:
                    shutil.copyfileobj(fh, out, 1024 * 1024)
        if op.stat().st_size != total:
            error(f"  assembled size {op.stat().st_size} != expected {total}")
            return 1
        for _, _, _, pf in parts:
            pf.unlink()
        if not _post_check(tf, op):
            return 1
        info(f"✓ {tf} — {op.stat().st_size / 1e9:.2f} GB (dual-stream)")
        return 0

    # Filter to pending downloads
    pending = []
    for i, tf in enumerate(target_files):
        label = f"[{i+1}/{len(target_files)}]"
        result = _build_curl(tf)
        if result is None:
            op = dest_dir / tf
            info(f"{label} Skipping {tf} — already complete ({op.stat().st_size / 1e9:.2f} GB)")
        else:
            pending.append((i, result))
            info(f"{label} Queued: {tf}")

    if not pending:
        info("All files already downloaded.")
    elif len(pending) == 1 and parallel > 1 and not _has_partial(pending[0][1][1]):
        # Single file, multiple streams → byte-range dual-stream (resume + retry survive HF stalls)
        # Skipped when a plain partial already exists: multistream assembles from
        # .partN files and truncates the target, which would throw those bytes away.
        # Single-stream `curl -C -` resumes them instead.
        info(f"\n(Ctrl-C to pause — re-run same command to resume)\n")
        idx, (tf, op, _cmd) = pending[0]
        info(f"Downloading {tf} ({parallel} streams)...")
        if _download_multistream(tf, op, parallel) != 0:
            return 1
    elif parallel <= 1 or len(pending) == 1:
        # Sequential download
        info(f"\n(Ctrl-C to pause — re-run same command to resume)\n")
        for idx, (tf, op, cmd) in pending:
            label = f"[{idx+1}/{len(target_files)}] " if len(target_files) > 1 else ""
            info(f"{label}Downloading {tf}...")
            try:
                subprocess.run(cmd, check=True)
            except subprocess.CalledProcessError as e:
                error(f"Download failed (curl exit {e.returncode}). Re-run to resume.")
                return 1
            except KeyboardInterrupt:
                info("\nDownload paused. Re-run to resume.")
                return 0
            if not _post_check(tf, op):
                return 1
            info(f"✓ {tf} — {op.stat().st_size / 1e9:.2f} GB")
    else:
        # Parallel download — N shards at a time
        info(f"\nDownloading {len(pending)} shards ({parallel} parallel streams)...")
        info(f"(Ctrl-C to pause — re-run same command to resume)\n")

        def _run_curl(item):
            idx, (tf, op, cmd) = item
            r = subprocess.run(cmd)
            return idx, tf, op, r.returncode

        try:
            with ThreadPoolExecutor(max_workers=parallel) as pool:
                futures = {pool.submit(_run_curl, item): item for item in pending}
                for fut in as_completed(futures):
                    idx, tf, op, rc = fut.result()
                    label = f"[{idx+1}/{len(target_files)}]"
                    if rc != 0:
                        error(f"{label} {tf} failed (curl exit {rc}). Re-run to resume.")
                        return 1
                    if not _post_check(tf, op):
                        return 1
                    info(f"{label} ✓ {tf} — {op.stat().st_size / 1e9:.2f} GB")
        except KeyboardInterrupt:
            info("\nDownload paused. Re-run to resume.")
            return 0

    return 0


def cmd_download(args):
    # The Xet backend can stall indefinitely (zero bytes written, no error).
    # Disable before any huggingface_hub import so snapshot_download never
    # routes through it. setdefault so a user override still wins.
    os.environ.setdefault("HF_HUB_DISABLE_XET", "1")
    repo = args.hf_repo
    quant = (args.quant or "Q4_K_M").upper()
    rate_mbps = args.rate
    # curl --limit-rate uses 'k' = 1000 bytes; 75 Mbps = 9375 KB/s
    rate_kBps = int(rate_mbps * 1_000_000 / 8 / 1000)
    explicit_file = args.file
    list_only = args.list_files

    # ── Probe repo ────────────────────────────────────────────────────────────
    info(f"Probing repo: {repo}")
    # ?blobs=true is load-bearing: the plain endpoint returns siblings with only
    # rfilename, so `size` is None and the "already complete" skip below can never
    # fire — every re-run re-queues finished files. blobs=true adds size + lfs.sha256.
    data = _hf_api_get(f"/api/models/{repo}?blobs=true")
    if not data:
        error(f"Cannot reach HuggingFace API for repo '{repo}'.")
        return 1

    siblings = data.get("siblings", [])
    all_files  = [f["rfilename"] for f in siblings]
    gguf_files = [f for f in all_files if f.endswith(".gguf")]
    has_safetensors = any(f.endswith(".safetensors") for f in all_files)

    # ── --list ────────────────────────────────────────────────────────────────
    if list_only:
        info(f"\nFiles in {repo} ({len(all_files)} total, {len(gguf_files)} GGUF):")
        for f in sorted(all_files):
            tag = "  [gguf]" if f.endswith(".gguf") else "        "
            info(f"{tag} {f}")
        return 0

    # ── --backend vllm: keep safetensors, skip GGUF conversion ───────────────
    if getattr(args, "backend", None) == "vllm":
        if not has_safetensors:
            error(f"--backend vllm needs a safetensors repo; '{repo}' has none.")
            return 1
        base = repo.split("/")[-1]
        dest = MODELS_DIR / "hf" / base
        target_files = _filter_ignored(all_files)
        if not target_files:
            error(f"Nothing to download from '{repo}' after filtering.")
            return 1
        if args.dry_run:
            info(f"\n[dry-run] Would download {len(target_files)} file(s):")
            info(f"  repo:   {repo}")
            for f in sorted(target_files):
                info(f"  file:   {f}")
            info(f"  dest:   {dest}")
            info(f"  rate:   {rate_mbps} Mbps ({rate_kBps} KB/s)")
            info(f"  streams:{getattr(args, 'parallel', 1)}")
            info(f"  resume: yes (-C -)")
            return 0
        info(f"Downloading safetensors → {dest}")
        dest.mkdir(parents=True, exist_ok=True)
        # Biggest file first, so a shard set overlaps the long pole with the rest
        # instead of leaving it alone on a single stream at the end.
        sizes = {s["rfilename"]: (s.get("size") or 0) for s in siblings}
        target_files = sorted(target_files, key=lambda f: -sizes.get(f, 0))
        if _hf_curl_fetch(repo, siblings, target_files, dest,
                          parallel=getattr(args, "parallel", 1),
                          rate_kBps=rate_kBps, rate_mbps=rate_mbps,
                          verify=getattr(args, "verify", False)) != 0:
            return 1
        total_bytes = sum((dest / f).stat().st_size for f in target_files if (dest / f).exists())
        info(f"\n✓ Downloaded: {dest} ({total_bytes / 1e9:.2f} GB)")
        info(f"\nNext: model-swap create <profile-name> {dest} --backend vllm")
        return 0

    # ── Safetensors-only repo: download → convert → quantize → GGUF ──────────
    # Fetched with curl, not snapshot_download: hf_hub cannot resume a killed
    # download (see _hf_curl_fetch), and this path pulls the same 50GB+ repos.
    if has_safetensors and not gguf_files:
        import subprocess as _sp
        base = repo.split("/")[-1]
        staging = MODELS_DIR / "_staging" / repo.replace("/", "-")
        f16 = MODELS_DIR / "_staging" / f"{base}-f16.gguf"
        out = MODELS_DIR / f"{base}-{quant}.gguf"
        convert = LLAMA_BIN_DEFAULT.parent.parent.parent / "convert_hf_to_gguf.py"
        quantize = LLAMA_BIN_DEFAULT.parent / "llama-quantize"

        if out.exists():
            info(f"{out.name} already exists at {out} — nothing to do.")
            return 0
        if not convert.exists():
            error(f"convert script not found: {convert}"); return 1
        if not quantize.exists():
            error(f"llama-quantize not found: {quantize}"); return 1

        info(f"Repo '{repo}' is safetensors-only → download + convert to {quant} GGUF.")
        staging_files = _filter_ignored(all_files)
        sizes = {s["rfilename"]: (s.get("size") or 0) for s in siblings}
        staging_files = sorted(staging_files, key=lambda f: -sizes.get(f, 0))
        if args.dry_run:
            # Without this the "dry" run downloads the whole repo for real.
            info(f"\n[dry-run] Would download {len(staging_files)} file(s)"
                 f" ({sum(sizes.get(f, 0) for f in staging_files) / 1e9:.2f} GB):")
            info(f"  repo:    {repo}")
            info(f"  staging: {staging}")
            info(f"  convert: {convert} → {f16}")
            info(f"  quant:   {quant} → {out}")
            info(f"  streams: {getattr(args, 'parallel', 1)}")
            return 0
        info(f"[1/3] Download safetensors → {staging}")
        staging.mkdir(parents=True, exist_ok=True)
        if _hf_curl_fetch(repo, siblings, staging_files, staging,
                          parallel=getattr(args, "parallel", 1),
                          rate_kBps=rate_kBps, rate_mbps=rate_mbps,
                          verify=getattr(args, "verify", False)) != 0:
            return 1

        info(f"[2/3] Convert → f16 GGUF (slow)")
        if _sp.run([sys.executable, str(convert), str(staging),
                    "--outfile", str(f16), "--outtype", "f16"]).returncode != 0:
            error("convert_hf_to_gguf.py failed"); return 1

        info(f"[3/3] Quantize → {quant}")
        if _sp.run([str(quantize), str(f16), str(out), quant]).returncode != 0:
            error("llama-quantize failed"); return 1
        f16.unlink(missing_ok=True)  # reclaim the ~70GB f16 intermediate

        info(f"Created {out}")
        info(f"  Next: model-swap create <profile-name> {out.name}")
        return 0

    if not gguf_files:
        error(f"No GGUF files found in {repo}.")
        return 1

    # ── Select target file(s) — shard-aware ─────────────────────────────────
    import re as _re
    _SHARD_RE = _re.compile(r'^(.+)-(\d{5})-of-(\d{5})\.gguf$')

    if explicit_file:
        if explicit_file not in gguf_files:
            error(f"'{explicit_file}' not in repo. Available GGUFs:")
            for f in gguf_files:
                info(f"  {f}")
            return 1
        # If explicit file is shard 1, grab all sibling shards
        m = _SHARD_RE.match(explicit_file)
        if m:
            prefix, _, total = m.group(1), m.group(2), m.group(3)
            target_files = sorted(
                f for f in gguf_files if f.startswith(prefix) and f.endswith(".gguf")
                and _SHARD_RE.match(f) and _SHARD_RE.match(f).group(3) == total
            )
        else:
            target_files = [explicit_file]
    else:
        matches = [f for f in gguf_files if quant in f.upper()]
        if not matches:
            error(f"No GGUF matching '{quant}'. Available:")
            for f in gguf_files:
                info(f"  {f}")
            return 1

        # Separate single-file quants from shard sets
        single = [f for f in matches if not _SHARD_RE.match(f)]
        shards = [f for f in matches if _SHARD_RE.match(f)]

        if single:
            # Prefer single-file quant (original behavior)
            target_files = [min(single, key=len)]
        elif shards:
            # Group shards by prefix+total, pick the set matching quant
            shard_groups = {}
            for f in shards:
                m = _SHARD_RE.match(f)
                key = (m.group(1), m.group(3))
                shard_groups.setdefault(key, []).append(f)
            # Pick the first (usually only) shard set
            target_files = sorted(next(iter(shard_groups.values())))
        else:
            target_files = [min(matches, key=len)]  # fallback

        if len(target_files) > 1:
            total_shards = len(target_files)
            info(f"Shard set detected ({total_shards} files):")
            for f in target_files:
                info(f"  {f}")
        elif len(matches) > 1:
            info(f"Multiple '{quant}' matches — selecting: {target_files[0]}")
            for f in matches:
                marker = " ← selected" if f == target_files[0] else ""
                info(f"  {f}{marker}")

    # ── Dry run ───────────────────────────────────────────────────────────────
    if args.dry_run:
        info(f"\n[dry-run] Would download {len(target_files)} file(s):")
        info(f"  repo:   {repo}")
        for f in target_files:
            info(f"  file:   {f}")
        info(f"  output: {MODELS_DIR}/")
        info(f"  rate:   {rate_mbps} Mbps ({rate_kBps} KB/s)")
        info(f"  resume: yes (-C -)")
        return 0

    # ── Download all target files (resume-capable, optional parallelism) ──
    parallel = getattr(args, "parallel", 1)
    if _hf_curl_fetch(repo, siblings, target_files, MODELS_DIR,
                      parallel=parallel, rate_kBps=rate_kBps,
                      rate_mbps=rate_mbps,
                      verify=getattr(args, "verify", False)) != 0:
        return 1

    # ── Summary ───────────────────────────────────────────────────────────────
    total_bytes = sum((MODELS_DIR / f).stat().st_size for f in target_files if (MODELS_DIR / f).exists())
    info(f"\n✓ Downloaded {len(target_files)} file(s): {total_bytes / 1e9:.2f} GB total")
    first_file = target_files[0]
    info(f"\nNext steps:")
    info(f"  model-swap create <profile-name> {first_file}")
    info(f"  model-swap load   <profile-name>")
    return 0


# ── Backend registry (`model-swap backends`) ─────────────────────────────────
# The orientation surface: four backends dispatch off a profile's `backend:`
# key (_detect_backend), and nothing in --help ever said so.
#
# Every fact that already exists as a constant is READ from that constant
# (FT_PORT, _ft_devices(), DS4_BIN_DEFAULT, VLLM_PYTHON, PARAM_MAP, ALL_SLOTS,
# the timeout constants). Retyping them as string literals is how a surface
# silently rots the first time someone moves a constant. Profile counts are
# scanned from PROFILES_DIR, never hardcoded — ds4 must be able to report 0.
# Prose lives in docs/backends/<name>.md; this is the machine-readable view.

BACKENDS_DOCS_DIR = Path(__file__).resolve().parent / "docs" / "backends"

# Keys every backend's profile shares (load_profile / cmd_load read these).
_COMMON_PROFILE_KEYS = [
    ("description", "str", False, "", "Free text; shown by list/info"),
    ("vram_required_mb", "int", False, 0, "Pre-flight gate vs capacity and vs live free VRAM (300MiB margin). 0 disables both"),
    ("health_timeout", "int (s)", False, None, "Readiness budget; checked BEFORE the backend default"),
    ("env", "map", False, {}, "Extra process env, applied AFTER device pinning so it can override"),
    ("extra_args", "list", False, [], "Appended verbatim to the command, last"),
]


def _backend_profile_counts():
    """profile-count per backend, scanned from PROFILES_DIR (never hardcoded).
    A profile with no `backend:` key is llama (_detect_backend)."""
    counts = {name: 0 for name in ("llama", "vllm", "ds4", "freetoken")}
    if not PROFILES_DIR.exists():
        return counts
    for path in sorted(PROFILES_DIR.glob("*.yaml")):
        backend = "llama"
        try:
            data = yaml.safe_load(path.read_text())
            if isinstance(data, dict):
                backend = str(data.get("backend", "llama"))
        except Exception:
            continue
        counts[backend] = counts.get(backend, 0) + 1
    return counts


