def cmd_backends(args):
    """Read-only: prints backend facts. Touches no GPU state, no contract."""
    reg = _backend_registry()
    name = getattr(args, "backend_name", None)

    if name:
        entry = reg.get(name)
        if not entry:
            error(f"Unknown backend '{name}' — one of: {', '.join(reg)}")
            return 4
        if _json_mode:
            json_out(entry)
            return 0
        info(f"{entry['name']} — {entry['summary']}")
        info(f"  status    {entry['status']}")
        info(f"  mode      {entry['mode']}")
        info(f"  runs      {entry['runs']}")
        info(f"  port      {entry['port']}")
        info(f"  devices   " + "\n            ".join(entry["devices"]))
        info(f"  health    {entry['health']['probe']} (default timeout {entry['health']['default_timeout_s']}s)")
        info(f"  watchdog  {entry['health']['idle_watchdog'] or 'none'}")
        info(f"  profiles  {entry['profiles']} found")
        info(f"  docs      {entry['docs'] or '(missing)'}")

        info(f"\nProfile keys:")
        info(f"  {'key':<20} {'type':<10} {'req':<4} {'default':<22} meaning")
        for f in entry["schema"]:
            dflt = "—" if f["default"] is None else repr(f["default"]).replace(str(Path.home()), "~")
            if len(dflt) > 22:
                dflt = dflt[:21] + "…"
            info(f"  {f['key']:<20} {f['type']:<10} {'yes' if f['required'] else 'no':<4} "
                 f"{dflt:<22} {f['meaning']}")

        info(f"\n{entry['param_block']}: key → flag")
        for k, flag in entry["param_flags"].items():
            info(f"  {k:<32} {flag}")

        info("\nLifecycle:")
        for i, step in enumerate(entry["lifecycle"], 1):
            info(f"  {i}. {step}")

        info("\nGotchas:")
        for g in entry["gotchas"]:
            info(f"  - {g}")
        return 0

    if _json_mode:
        json_out(reg)
        return 0

    info(f"{'backend':<10} {'runs':<34} {'port':<6} {'mode':<9} {'prof':<5} devices")
    for entry in reg.values():
        runs = entry["runs"].split(" ")[0].replace(str(Path.home()), "~")
        devices = ", ".join(d.split(" (")[0] for d in entry["devices"])
        info(f"{entry['name']:<10} {runs:<34} {entry['port']:<6} {entry['mode']:<9} "
             f"{entry['profiles']:<5} {devices}")
    info("")
    for entry in reg.values():
        info(f"  {entry['name']:<10} [{entry['status'].split(' —')[0].split(' (')[0]}] {entry['pick_when']}")
    info(f"\nDeep view: model-swap backends <name> [--json]   (docs: {BACKENDS_DOCS_DIR}/<name>.md)")
    return 0


