def cmd_create(args):
    name = args.name
    model_file = args.model_file

    if (PROFILES_DIR / f"{name}.yaml").exists():
        error(f"Profile '{name}' already exists. Use 'edit' to modify or 'remove' first.")
        return 1

    # ── vLLM template: model is an HF repo ID or absolute local dir ──────────
    if getattr(args, "backend", None) == "vllm":
        if os.path.isabs(model_file) and not Path(model_file).exists():
            info(f"Warning: local model dir '{model_file}' not found")
        profile = {
            "backend": "vllm",
            "model": model_file,  # repo ID or absolute dir — kept verbatim
            "description": args.description or "",
            "vram_required_mb": args.vram or 24000,
            "vllm_params": {
                "gpu_memory_utilization": 0.95,
                "max_model_len": args.ctx_size or 131072,
                "tensor_parallel_size": 1,
                "enable_chunked_prefill": True,
                "max_num_seqs": 4,
            },
        }
        path = PROFILES_DIR / f"{name}.yaml"
        with open(path, "w") as f:
            yaml.dump(profile, f, default_flow_style=False, sort_keys=False)
        info(f"Created vLLM profile: {name}")
        info(f"  Path: {path}")
        info(f"  Model: {model_file}")
        info(f"\nSet quantization (gptq/awq/fp8/...) with: model-swap edit {name}")
        return 0

    # ── ds4 template: NeutronStar SSD-streaming MoE on the primary ───────────
    if getattr(args, "backend", None) == "ds4":
        ds4_basename = os.path.basename(model_file)
        if not (MODELS_DIR / ds4_basename).exists():
            info(f"Warning: model file '{ds4_basename}' not found in {MODELS_DIR}")
        profile = {
            "backend": "ds4",
            "model": ds4_basename,
            "description": args.description or "",
            "vram_required_mb": args.vram or 22000,
            "idle_stop": False,  # ds4 has no /metrics; watchdog can't fire
            "ds4_params": {
                "ctx": args.ctx_size or 8192,
                "ssd_streaming": True,
                "ssd_streaming_cache_experts": "6GB",
                "warm_weights": True,
            },
            "env": {
                "DS4_CUDA_HOST_EXPERT_CACHE_GB": 72,
                "DS4_CUDA_PARALLEL_FETCH_THREADS": 16,
                "DS4_CUDA_ARENA_VRAM_RESERVE_GB": 3,
                "DS4_CUDA_NO_PINNED_ARENA_FALLBACK": 1,
            },
        }
        path = PROFILES_DIR / f"{name}.yaml"
        with open(path, "w") as f:
            yaml.dump(profile, f, default_flow_style=False, sort_keys=False)
        info(f"Created ds4 profile: {name}")
        info(f"  Path: {path}")
        info(f"  Model: {ds4_basename}")
        info(f"\nTune expert caches with: model-swap edit {name}")
        return 0

    # Check if model file exists (could be just filename or full path)
    if os.path.isabs(model_file):
        model_basename = os.path.basename(model_file)
    else:
        model_basename = model_file

    if not (MODELS_DIR / model_basename).exists() and not Path(model_file).exists():
        info(f"Warning: model file '{model_basename}' not found in {MODELS_DIR}")

    profile = {
        "model": model_basename,
        "description": args.description or "",
        "vram_required_mb": args.vram or 18000,
        "params": {},
    }

    if args.ctx_size:
        profile["params"]["ctx_size"] = args.ctx_size
    if args.threads:
        profile["params"]["threads"] = args.threads
    profile["params"]["n_gpu_layers"] = args.n_gpu_layers or 99

    path = PROFILES_DIR / f"{name}.yaml"
    with open(path, "w") as f:
        yaml.dump(profile, f, default_flow_style=False, sort_keys=False)

    info(f"Created profile: {name}")
    info(f"  Path: {path}")
    info(f"  Model: {model_basename}")
