CONFIG_FILE = Path(os.environ.get("MODEL_SWAP_CONFIG")
                   or Path.home() / ".config/model-swap/config.yaml").expanduser()


def _load_config():
    try:
        with open(CONFIG_FILE) as f:
            cfg = yaml.safe_load(f) or {}
    except FileNotFoundError:
        sys.exit(f"model-swap: no config at {CONFIG_FILE}. Copy config.example.yaml "
                 "there (or point MODEL_SWAP_CONFIG at one) and describe your GPUs.")
    for key in ("gpus", "primary"):
        if not cfg.get(key):
            sys.exit(f"model-swap: {CONFIG_FILE} has no '{key}:' section")
    # YAML reads a numeric GPU name (e.g. 4090) as an int; names are strings everywhere else.
    cfg["gpus"] = {str(k): v for k, v in cfg["gpus"].items()}
    cfg["primary"]["gpu"] = str(cfg["primary"]["gpu"])
    for sc in (cfg.get("slots") or {}).values():
        sc["gpus"] = [str(g) for g in sc["gpus"]]
    for name in [cfg["primary"]["gpu"]] + [g for sc in (cfg.get("slots") or {}).values()
                                           for g in sc["gpus"]]:
        if name not in cfg["gpus"]:
            sys.exit(f"model-swap: {CONFIG_FILE} references GPU '{name}', not in gpus:")
    return cfg


