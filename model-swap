# ── GPU Slots ────────────────────────────────────────────────────────────
# Each slot is a dict consumed by the generic slot_* functions below, built from
# `slots:` in the config. A multi-GPU slot pools its cards via tensor split; the
# CUDA_VISIBLE_DEVICES order (the slot's `gpus:` order) sets visible device
# order, so a --tensor-split ratio maps onto the cards as listed, regardless of
# physical slot. Slots sharing a card or a port are mutually exclusive; a slot
# holding the primary card is exclusive with the primary server too. Eviction
# is bidirectional — see _slot_stop_conflicting() and _stop_slots_holding_primary().

def _make_slot(name, port, cuda_devices, uuid, vram_mb, extra_args=None, gpu_label=None):
    """Build a slot config dict. Avoids repeating the boilerplate."""
    return {
        "name": name,
        "port": port,
        "cuda_devices": cuda_devices,  # CUDA_VISIBLE_DEVICES value
        "uuid": uuid,
        "vram_mb": vram_mb,
        "gpu_label": gpu_label or "GPU pool",
        "log": Path(f"/tmp/llama-{name}.log"),
        "state": MODELS_DIR / f".active-{name}.json",
        "pid_file": Path(f"/tmp/llama-{name}.pid"),
        "activity": Path(f"/tmp/llama-{name}.activity"),
        "idle_timeout": SLOT_IDLE_TIMEOUT_S,
        "last": MODELS_DIR / f".last-{name}.json",  # last explicit ensure; a bare ensure (gateway wake) reloads it
        "health_url": f"http://{HOST}:{port}/health",
        "models_url": f"http://{HOST}:{port}/v1/models",
        "extra_args": extra_args or [],
    }


def _slot_from_config(key, sc):
    gpus = sc["gpus"]
    uuids = [GPUS[g]["uuid"] for g in gpus]
    solo = len(gpus) == 1
    return _make_slot(
        sc.get("name", key), int(sc["port"]), ",".join(uuids),
        uuids[0] if solo else None, sum(GPUS[g]["vram_mb"] for g in gpus),
        extra_args=sc.get("extra_args"),
        gpu_label=sc.get("label") or (GPUS[gpus[0]].get("label") if solo else None),
    )


