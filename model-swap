def build_parser():
    # Device vocabulary comes from the config: the primary card's name, plus the
    # secondary slot's alias when there is a secondary slot.
    _device_choices = [PRIMARY_GPU] + ([SECONDARY_ALIAS] if SLOT_SECONDARY else [])
    _secondary_label = SLOT_SECONDARY["gpu_label"] if SLOT_SECONDARY else "secondary"
    _slot_help = [k if s["uuid"] else f"{k} ({round(s['vram_mb'] / 1024)}GB pool)"
                  for k, s in ALL_SLOTS.items()]

    # Shared flags inherited by every subcommand
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="JSON output")
    common.add_argument("--quiet", "-q", action="store_true", help="Suppress non-essential output")
    common.add_argument("--verbose", "-v", action="store_true", help="Debug output")
    common.add_argument("--dry-run", action="store_true", help="Show what would happen without doing it")
    common.add_argument("--timeout", type=int, default=LLAMA_DEFAULT_TIMEOUT,
                        help=f"Health check timeout in seconds (default: {LLAMA_DEFAULT_TIMEOUT})")

    parser = argparse.ArgumentParser(
        prog="model-swap",
        parents=[common],
        description=f"Hot-swap local LLM models on llama-server ({GPUS[PRIMARY_GPU].get('label', PRIMARY_GPU)}).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Profiles: %(prog)s list | Load: %(prog)s load <profile> | Status: %(prog)s status\n"
               "Backends: %(prog)s backends [llama|vllm|ds4|freetoken] [--json]  "
               "(four backends dispatch off a profile's `backend:` key)",
    )

    sub = parser.add_subparsers(dest="command", help="Available commands")

    # load
    p = sub.add_parser("load", parents=[common], help="Load a model profile (stop current, start new)")
    p.add_argument("profile", help="Profile name (from <models_dir>/profiles/)")

    # stop
    p = sub.add_parser("stop", parents=[common], help="Stop the running llama-server")
    p.add_argument("--device", choices=_device_choices, default=None, help=f"GPU device (default: {PRIMARY_GPU})")

    # restart
    sub.add_parser("restart", parents=[common], help="Restart the current profile")

    # status
    sub.add_parser("status", parents=[common], help="Show server status, model info, and GPU stats")

    # list
    sub.add_parser("list", parents=[common], help="List available model profiles")

    # current
    sub.add_parser("current", parents=[common], help="Show the currently active profile name")

    # health
    sub.add_parser("health", parents=[common], help="Run GPU pre-flight checks and server health")

    # gpu
    sub.add_parser("gpu", parents=[common], help="All GPUs: VRAM, processes, lease, rogue detection (replaces nvidia-smi)")

    # ps
    sub.add_parser("ps", parents=[common], help="Show llama-server process info")

    # logs
    p = sub.add_parser("logs", parents=[common], help="Tail the llama-server log file")
    p.add_argument("-n", type=int, default=20, help="Number of lines to show (default: 20)")

    # ensure
    p = sub.add_parser("ensure", parents=[common], help="Ensure server is running (start if needed, noop if healthy)")
    p.add_argument("--profile", dest="ensure_profile", default=None,
                   help=f"Profile to load if server is down (default: last used or {DEFAULT_PROFILE})")
    p.add_argument("--device", choices=_device_choices, default=None, help=f"GPU device (default: {PRIMARY_GPU})")

    # secondary-ensure (alias for ensure --device <secondary alias>)
    p = sub.add_parser("secondary-ensure", parents=[common],
                       help=f"Ensure {_secondary_label} server is running (= slot secondary ensure)")
    p.add_argument("--gguf", help="Model path")
    p.add_argument("--ctx", type=int, help="Context size (default 32768)")
    p.add_argument("--profile", help="Named profile to resolve (alternative to --gguf)")
    p.add_argument("--idle-timeout", dest="idle_timeout", type=int, default=None,
                   help="Stop after N s without activity (default: config slot_idle_timeout_s)")

    # secondary-stop (alias for stop --device <secondary alias>)
    sub.add_parser("secondary-stop", parents=[common], help=f"Stop the {_secondary_label} server")

    # secondary-status
    sub.add_parser("secondary-status", parents=[common], help=f"Show {_secondary_label} server status")

    p = sub.add_parser("slot", parents=[common],
                       help="Manage a GPU slot: " + " | ".join(_slot_help))
    p.add_argument("slot", choices=list(ALL_SLOTS.keys()))
    p.add_argument("action", choices=["ensure", "stop", "status"])
    p.add_argument("--gguf", help="Model path (required for pool slots without slot_default_gguf)")
    p.add_argument("--ctx", type=int, help="Context size (default 32768)")
    p.add_argument("--profile", help="Named profile to resolve (alternative to --gguf)")
    p.add_argument("--idle-timeout", dest="idle_timeout", type=int, default=None,
                   help="ensure: stop the slot after N s without activity (default: config slot_idle_timeout_s)")

    # reserve (exclusive GPU access for a non-model-swap job)
    p = sub.add_parser("reserve", parents=[common], help="Reserve GPU(s) for exclusive use")
    p.add_argument("--devices", nargs="+", choices=_device_choices, default=list(_device_choices),
                   help="GPU devices to reserve (default: all listed)")
    p.add_argument("--reason", default="manual", help="Reason for reservation")
    p.add_argument("--reserve-timeout", dest="reserve_timeout", type=int, default=3600,
                   help="Reservation timeout in seconds (default: 3600)")

    # release (restore after reservation)
    p = sub.add_parser("release", parents=[common], help="Release GPU reservation and restore profiles")
    p.add_argument("--no-restore", action="store_true", help="Don't restore previous profiles")

    # lease (GPU lease — any device, holder identity + TTL)
    p = sub.add_parser("lease", parents=[common],
                       help="Acquire/renew/release/status a GPU lease on any device")
    p.add_argument("lease_action", choices=["acquire", "renew", "release", "status"],
                   help="Lease action")
    p.add_argument("--holder", default=None,
                   help="Lease holder name — REQUIRED for acquire (no default identity)")
    p.add_argument("--devices", nargs="+", default=LEASE_DEFAULT_DEVICES,
                   help=f"Devices: {' | '.join(_LEASE_DEVICE_MAP)} | <UUID> "
                        f"(default: {' '.join(LEASE_DEFAULT_DEVICES)})")
    p.add_argument("--force", action="store_true",
                   help="Acquire/release over another holder's lease or an actively-serving slot")
    p.add_argument("--lease-ttl", dest="lease_ttl", type=int, default=None,
                   help=f"Lease TTL seconds before stale (default: {LEASE_TTL_S})")

    # idle-stop
    p = sub.add_parser("idle-stop", parents=[common], help="Watch for idle and auto-stop server")
    p.add_argument("--minutes", dest="idle_minutes", type=float, default=None,
                   help="Minutes of idle before auto-stop (default: config primary.idle_timeout_s)")
    p.add_argument("--poll", dest="poll_seconds", type=int, default=None,
                   help="Seconds between activity polls (default: scales with the timeout)")
    p.add_argument("--daemon", "-d", action="store_true",
                   help="Fork to background and return immediately")

    # info
    p = sub.add_parser("info", parents=[common], help="Show detailed profile information")
    p.add_argument("profile", help="Profile name")

    # create
    p = sub.add_parser("create", parents=[common], help="Create a new model profile")
    p.add_argument("name", help="Profile name")
    p.add_argument("model_file", help="Model filename (in <models_dir>/) or full path")
    p.add_argument("--description", "-d", help="Profile description")
    p.add_argument("--ctx-size", type=int, help="Context size")
    p.add_argument("--threads", type=int, help="CPU threads")
    p.add_argument("--n-gpu-layers", type=int, help="GPU layers (default: 99)")
    p.add_argument("--vram", type=int, help="Estimated VRAM required in MiB (default: 18000)")
    p.add_argument("--backend", choices=["llama", "vllm", "ds4", "freetoken"], default="llama",
                   help="Backend (default: llama). vllm writes a vllm_params schema; "
                        "ds4 writes a NeutronStar ds4_params + env template.")

    # edit
    p = sub.add_parser("edit", parents=[common], help="Open a profile in $EDITOR")
    p.add_argument("profile", help="Profile name")

    # remove
    p = sub.add_parser("remove", parents=[common], help="Remove a model profile")
    p.add_argument("profile", help="Profile name")
    p.add_argument("--force", "-f", action="store_true", help="Skip confirmation")

    # backends
    p = sub.add_parser("backends", parents=[common],
                       help="List the serving backends (llama/vllm/ds4/freetoken) — read-only")
    p.add_argument("backend_name", nargs="?", metavar="backend",
                   choices=["llama", "vllm", "ds4", "freetoken"],
                   help="Deep view for one backend: profile key schema, lifecycle, gotchas")

    # validate
    p = sub.add_parser("validate", parents=[common], help="Validate profile(s) — check model exists and VRAM fits")
    p.add_argument("profile", nargs="?", help="Profile name (omit to validate all)")

    # download
    p = sub.add_parser("download", parents=[common],
                       help="Download a GGUF from HuggingFace (rate-limited, resume-capable)")
    p.add_argument("hf_repo", help="HuggingFace repo (e.g. unsloth/Qwen3.6-35B-A3B-GGUF)")
    p.add_argument("--quant", default="Q4_K_M", help="Quantization filter (default: Q4_K_M)")
    p.add_argument("--file", dest="file", default=None,
                   help="Exact GGUF filename to download (overrides --quant)")
    p.add_argument("--rate", type=float, default=HF_DEFAULT_RATE_MBPS,
                   help=f"Download rate limit in Mbps (default: {HF_DEFAULT_RATE_MBPS})")
    p.add_argument("--backend", choices=["llama", "vllm"], default="llama",
                   help="vllm: keep safetensors in <models_dir>/hf/ (skip GGUF conversion)")
    p.add_argument("--parallel", type=int, default=1, choices=[1, 2],
                   help="Concurrent streams: shards in parallel, or byte-range dual-stream for a single file (default: 1, max: 2)")
    p.add_argument("--verify", action="store_true",
                   help="Hash every downloaded file against the repo's sha256/blobId. "
                        "Files under 64MB are always checked; this extends it to "
                        "multi-GB shards (adds ~1 min per 55GB)")
    p.add_argument("--list", dest="list_files", action="store_true",
                   help="List files in repo and exit")

    return parser


# ── Main ─────────────────────────────────────────────────────────────────────

def main():
    global _json_mode, _quiet_mode, _verbose_mode

    parser = build_parser()
    args = parser.parse_args()

    # `common` is a parent of BOTH the top-level parser and every subparser, so a
    # global flag placed BEFORE the subcommand (`model-swap --dry-run load X`) was
    # set by the top parser and then clobbered back to False by the subparser's
    # own default. `--dry-run load` therefore really loaded. Make them sticky.
    for _flag, _dest in (("--dry-run", "dry_run"), ("--json", "json"),
                         ("--quiet", "quiet"), ("--verbose", "verbose"),
                         ("-q", "quiet"), ("-v", "verbose")):
        if _flag in sys.argv[1:]:
            setattr(args, _dest, True)

    _json_mode = args.json
    _quiet_mode = args.quiet
    _verbose_mode = args.verbose

    if args.command is None:
        # Default to status
        args.command = "status"

    commands = {
        "load": cmd_load,
        "stop": cmd_stop,
        "restart": cmd_restart,
        "status": cmd_status,
        "list": cmd_list,
        "current": cmd_current,
        "health": cmd_health,
        "gpu": cmd_gpu,
        "ps": cmd_ps,
        "logs": cmd_logs,
        "info": cmd_info,
        "create": cmd_create,
        "edit": cmd_edit,
        "remove": cmd_remove,
        "validate": cmd_validate,
        "backends": cmd_backends,
        "ensure": cmd_ensure,
        "idle-stop": cmd_idle_stop,
        "download": cmd_download,
        "secondary-ensure": cmd_secondary_ensure,
        "secondary-stop": cmd_secondary_stop,
        "secondary-status": cmd_secondary_status,
        "slot": cmd_slot,
        "reserve": cmd_reserve,
        "release": cmd_release,
        "lease": cmd_lease,
    }

    handler = commands.get(args.command)
    if handler:
        sys.exit(handler(args))
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
