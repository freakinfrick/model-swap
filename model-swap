def _ft_state():
    """Live FreeToken state (state file + pid alive), else None. A dead pid
    clears the stale file — model-swap launched it, nobody else writes it."""
    if not FT_STATE_FILE.exists():
        return None
    try:
        with open(FT_STATE_FILE) as f:
            st = json.load(f)
    except Exception:
        return None
    try:
        os.kill(st["pid"], 0)
    except Exception:
        FT_STATE_FILE.unlink(missing_ok=True)
        return None
    return st


def _ft_save_state(profile_name, model, served_name, pid, port, device):
    with open(FT_STATE_FILE, "w") as f:
        json.dump({"profile": profile_name, "model": model,
                   "served_name": served_name, "pid": pid, "port": port,
                   "device": device,
                   "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S")}, f, indent=2)


def _ft_serving(port, model, timeout_s=5):
    """True when FreeToken can actually GENERATE, not merely when its HTTP
    frontend answers.

    `GET /health` is served by the uvicorn frontend, which binds ~5s in while
    the scheduler process is still materializing weights. Every common failure
    mode (dtype crash, CUDA OOM, weight KeyError)
    killed the ENGINE after /health had already gone green, so the load path
    reported success, published the contract, and left the gateway routing at a
    corpse. A one-token completion is the only probe that proves the whole
    pipeline; the frontend answers 503 while the backend is gone."""
    body = json.dumps({"model": model, "messages": [{"role": "user", "content": "hi"}],
                       "max_tokens": 1, "temperature": 0}).encode()
    req = Request(f"http://{HOST}:{port}/v1/chat/completions", data=body,
                  headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urlopen(req, timeout=timeout_s) as r:
            return r.status == 200
    except HTTPError as e:
        # 400/422 = the engine is alive and rejected the probe's arguments
        # (e.g. an unknown model id); only 5xx means "backend gone".
        return e.code < 500
    except Exception:
        return False


def _ft_wait_ready(pid, port, model, timeout_s):
    """Wait for FreeToken to be genuinely serving. Returns (ok, elapsed, reason)
    with the same contract as wait_for_health, so callers stay uniform."""
    start = time.time()
    proc = _SERVER_PROCS.get(pid)
    while time.time() - start < timeout_s:
        if proc is not None and proc.poll() is not None:
            return False, round(time.time() - start, 1), "process_died"
        if proc is None and pid is not None:
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                return False, round(time.time() - start, 1), "process_died"
        if _ft_serving(port, model):
            return True, round(time.time() - start, 1), "healthy"
        time.sleep(1.0)
    return False, round(time.time() - start, 1), "timeout"


def _ft_wait_vram_free(device, timeout_s=90, floor_mb=1024):
    """Block until the borrowed card's VRAM is actually reclaimed.

    A dead `ft` pid does not mean free memory: the driver tears down a 22GB
    context asynchronously, so `release`'s restore fired 3.5s later and llama
    died with `cudaMalloc failed: out of memory` on a card nvidia-smi reported
    as empty moments afterwards. So: verify no orphan still holds VRAM before
    restoring. Returns (ok, used_mb)."""
    uuid = (GPUS.get(str(device)) or {}).get("uuid")
    if not uuid:
        return True, None
    deadline = time.time() + timeout_s
    used = None
    while time.time() < deadline:
        try:
            r = subprocess.run(["nvidia-smi", f"--id={uuid}",
                                "--query-gpu=memory.used",
                                "--format=csv,noheader,nounits"],
                               capture_output=True, text=True, timeout=10)
            used = int(r.stdout.strip().splitlines()[0])
            if used <= floor_mb:
                return True, used
        except Exception:
            return True, used  # can't measure — don't block the teardown
        time.sleep(1.0)
    return False, used


def _ft_stop(pid, timeout_s=60):
    """SIGTERM ft serve, wait for a graceful exit (it must release VRAM);
    SIGKILL is the backstop. Returns (killed, message)."""
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return True, "Process already gone"
    deadline = time.time() + timeout_s
    while time.time() < deadline:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return True, f"Stopped (PID {pid})"
        time.sleep(1)
    try:
        os.kill(pid, signal.SIGKILL)
        time.sleep(2)
    except ProcessLookupError:
        pass
    return True, f"Force-killed (PID {pid}) — verify no VRAM orphan"


