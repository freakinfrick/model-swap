# os.kill(pid, 0) — an unreaped exited child is a zombie and still answers
# kill(pid, 0) successfully, so that check never sees a crash (see wait_for_health).
_SERVER_PROCS = {}

_GPU_HW = None


def _gpu_hw():
    """{uuid: {"index": str, "arch": str}} from nvidia-smi, cached per process.

    Hardware facts are queried, not configured: nvidia-smi's index is PCI bus
    order (what vLLM needs under CUDA_DEVICE_ORDER=PCI_BUS_ID) and compute_cap
    is what FreeToken's kernel JIT must be told. A `pci_index:`/`arch:` on a
    GPU in the config overrides the query."""
    global _GPU_HW
    if _GPU_HW is None:
        _GPU_HW = {}
        try:
            r = subprocess.run(["nvidia-smi", "--query-gpu=uuid,index,compute_cap",
                                "--format=csv,noheader"],
                               capture_output=True, text=True, timeout=10)
            for line in r.stdout.splitlines():
                parts = [p.strip() for p in line.split(",")]
                if len(parts) == 3:
                    _GPU_HW[parts[0]] = {"index": parts[1], "arch": parts[2]}
        except Exception:
            pass
    return _GPU_HW


def _gpu_pci_index(name):
    g = GPUS[name]
    return str(g.get("pci_index") or _gpu_hw().get(g["uuid"], {}).get("index") or g["uuid"])


def _gpu_arch(name):
    g = GPUS[name]
    return str(g.get("arch", _gpu_hw().get(g["uuid"], {}).get("arch", "")))


def _uuid_to_pci(uuid):
    """vLLM chokes on UUIDs in CUDA_VISIBLE_DEVICES and needs PCI indices."""
    for name, g in GPUS.items():
        if g["uuid"] == uuid:
            return _gpu_pci_index(name)
    return uuid

