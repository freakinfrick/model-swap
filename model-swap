def _ft_devices():
    """device → (CUDA_VISIBLE_DEVICES, reserve vocabulary, slot to evict).

    Any configured GPU can be borrowed. The primary card reserves under its
    own name; any other card reserves the secondary alias and evicts the
    single-card slot that sits on it."""
    out = {}
    for name in GPUS:
        if name == PRIMARY_GPU:
            out[name] = (_gpu_pci_index(name), [PRIMARY_GPU], None)
            continue
        slot = next((k for k, s in (CFG.get("slots") or {}).items() if s["gpus"] == [name]), None)
        out[name] = (_gpu_pci_index(name), [SECONDARY_ALIAS], slot)
    return out


# Compute capability of each borrowable card (_gpu_arch), passed to FreeToken's
# kernel JIT. Without it, tvm-ffi (kernel/utils.py -> tvm_ffi/cpp/extension.py:
# _get_cuda_target) shells `nvidia-smi --query-gpu=compute_cap` and takes ROW 0 —
# and nvidia-smi ignores CUDA_VISIBLE_DEVICES, so on a mixed rig row 0 may be a
# different card than the one the borrow pinned. That made an sm_89 borrow try to
# build sm_120 kernels ("nvcc fatal: Unsupported gpu architecture 'compute_120'").
# Pinning the arch per device fixes it with no toolkit change. NOTE: sm_120
# itself needs nvcc >= 12.8.
