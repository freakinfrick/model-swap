# ── Profile loading ──────────────────────────────────────────────────────────

def load_profile(name):
    """Load a profile YAML by name (without .yaml extension)."""
    path = PROFILES_DIR / f"{name}.yaml"
    if not path.exists():
        return None, f"Profile '{name}' not found at {path}"
    with open(path) as f:
        profile = yaml.safe_load(f)
    if not profile or "model" not in profile:
        return None, f"Profile '{name}' missing required 'model' field"
    profile.setdefault("description", "")
    profile.setdefault("vram_required_mb", 0)
    profile.setdefault("params", {})
    profile.setdefault("extra_args", [])
    profile.setdefault("binary", None)
    profile["_name"] = name
    profile["_path"] = str(path)
    return profile, None


def _detect_backend(profile):
    """Return 'llama' or 'vllm' based on profile field. Default 'llama'."""
    return profile.get("backend", "llama")


def _read_state_file():
    """Read .active.json. Returns dict or None."""
    if not STATE_FILE.exists():
        return None
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except Exception:
        return None


def _read_load_lock():
    """Return the live load-lock dict, or None. Clears PROVEN-stale locks only
    (dead holder pid, or past the TTL recorded in the lock itself). Unreadable/
    partial JSON is transient (another process mid-write) — assume held."""
    if not LOAD_LOCK.exists():
        return None
    try:
        lock = json.loads(LOAD_LOCK.read_text())
    except Exception:
        return {"pid": -1, "profile": "unknown"}  # mid-write — treat as held
    ttl = lock.get("ttl_s", LOAD_LOCK_TTL_S)
    try:
        expired = time.time() - LOAD_LOCK.stat().st_mtime > ttl
    except OSError:
        return None  # vanished between exists() and stat()
    alive = True
    try:
        os.kill(lock["pid"], 0)
    except ProcessLookupError:
        alive = False
    except Exception:
        pass  # PermissionError etc. — holder exists, assume alive
    if expired or not alive:
        LOAD_LOCK.unlink(missing_ok=True)
        return None
    return lock


def _acquire_load_lock(profile_name, ttl_s=LOAD_LOCK_TTL_S):
    """Atomically take the load lock (O_EXCL). Returns True on success,
    False when a live lock is held by another process."""
    payload = json.dumps({
        "pid": os.getpid(), "profile": profile_name, "ttl_s": ttl_s,
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S"),
    })
    for _ in range(2):  # second attempt after _read_load_lock clears a stale lock
        try:
            fd = os.open(LOAD_LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
            with os.fdopen(fd, "w") as f:
                f.write(payload)
            return True
        except FileExistsError:
            if _read_load_lock() is not None:
                return False  # live holder
    return False


def _refresh_load_lock():
    """Re-stamp the lock mtime so multi-attempt loads outlive the TTL."""
    try:
        os.utime(LOAD_LOCK)
    except OSError:
        pass


def _release_load_lock():
    """Unlink the lock only if this process owns it — never a successor's."""
    try:
        if json.loads(LOAD_LOCK.read_text()).get("pid") == os.getpid():
            LOAD_LOCK.unlink(missing_ok=True)
    except Exception:
        pass


def resolve_binary(profile):
    """Resolve server binary path. vLLM uses the venv python, not a binary."""
    if _detect_backend(profile) == "vllm":
        return VLLM_PYTHON  # always exists if vllm installed
    if _detect_backend(profile) == "freetoken":
        b = Path(profile["ft_bin"]) if profile.get("ft_bin") else FT_BIN_DEFAULT
        return b if b.exists() else None
    if _detect_backend(profile) == "ds4":
        b = Path(profile["binary"]) if profile.get("binary") else DS4_BIN_DEFAULT
        return b if b.exists() else None
    if profile.get("binary"):
        # Absolute path or name in the bin directory
        b = Path(profile["binary"])
        if b.is_absolute() and b.exists():
            return b
        candidate = LLAMA_BIN_DIR / profile["binary"]
        if candidate.exists():
            return candidate
        return None
    return LLAMA_BIN_DEFAULT


def list_profiles():
    """Return list of (name, profile) tuples sorted by name."""
    if not PROFILES_DIR.exists():
        return []
    profiles = []
    for p in sorted(PROFILES_DIR.glob("*.yaml")):
        name = p.stem
        prof, err = load_profile(name)
        if prof:
            profiles.append((name, prof))
    return profiles


def resolve_model_path(profile):
    """Resolve model to a path.

    llama: GGUF filename relative to <models_dir>/.
    vLLM: model is an HF repo ID or absolute local dir. Return the local dir if
    it exists, else the repo-ID string as-is (vllm fetches it; treat as 'exists').
    """
    if _detect_backend(profile) == "vllm":
        m = profile["model"]
        p = Path(m)
        if p.is_absolute() and p.exists():
            return p  # local safetensors dir
        return Path(m)  # HF repo ID — vllm resolves it
    if _detect_backend(profile) == "freetoken":
        m = profile["model"]
        p = Path(m)
        if p.is_absolute():
            return p if p.exists() else None
        if (MODELS_DIR / m).exists():
            return MODELS_DIR / m
        if "/" in m:
            return p  # HF repo ID — ft fetches (same contract as vllm)
        return None
    model_file = profile["model"]
    full = MODELS_DIR / model_file
    if full.exists():
        return full
    if Path(model_file).exists():
        return Path(model_file)
    return None


ARCHIVE_REMOTE = CFG.get("archive_remote")  # rclone remote holding archived weights, or None


def archived_entry(model_file):
    """Remote-relative path if this filename is in the archive manifest
    (<models_dir>/ARCHIVED.txt, rebuilt via `rclone lsf -R --files-only`), else None.
    Missing manifest or no `archive_remote:` → None; dangling profiles then just
    read [MISSING]."""
    if not ARCHIVE_REMOTE:
        return None
    try:
        lines = (MODELS_DIR / "ARCHIVED.txt").read_text().splitlines()
    except OSError:
        return None
    base = Path(model_file).name
    return next((l for l in lines if l and Path(l).name == base), None)


# ── Process detection ────────────────────────────────────────────────────────

def find_server_process(backend=None):
    """Find the inference server on our port. Returns (pid, cmdline) or (None, None).

    backend=None tries both llama and vllm process patterns (order: llama, vllm).
    Pass a specific backend to match only that pattern.
    """
    patterns = [PROC_PATTERNS[backend]] if backend else list(PROC_PATTERNS.values())
    for pattern in patterns:
        try:
            result = subprocess.run(
                ["pgrep", "-a", "-f", pattern],
                capture_output=True, text=True, timeout=5,
            )
            for line in result.stdout.strip().split("\n"):
                if not line.strip():
                    continue
                parts = line.split(None, 1)
                if len(parts) == 2:
                    pid = int(parts[0])
                    cmdline = parts[1]
                    if "pgrep" not in cmdline:
                        return pid, cmdline
        except Exception:
            pass
    return None, None


def parse_model_from_cmdline(cmdline):
    """Extract model id from a server command line (llama-server or vLLM).

    Prefer --model (both backends emit it). Only fall back to -m when its arg
    looks like a real model path — otherwise -m catches python's module flag
    in `python -m vllm.entrypoints.openai.api_server`.
    """
    if not cmdline:
        return None
    parts = cmdline.split()
    for i, p in enumerate(parts):
        if p == "--model" and i + 1 < len(parts):
            return os.path.basename(parts[i + 1])
    for i, p in enumerate(parts):
        if p == "-m" and i + 1 < len(parts):
            arg = parts[i + 1]
            if "/" in arg or arg.endswith(".gguf"):
                return os.path.basename(arg)
    return None


def match_profile_to_model(model_name):
    """Find which profile uses this model filename."""
    for name, prof in list_profiles():
        if prof["model"] == model_name:
            return name
    return None


def get_current_state():
    """Get current server state: {running, pid, model, profile, external, backend}."""
    state = {"running": False, "pid": None, "model": None, "profile": None,
             "external": False, "backend": "llama"}
    pid, cmdline = find_server_process()
    if pid is None:
        # FreeToken (own port, borrowed card): state file first, then a
        # cmdline marker for a manually started ft (assumes default venv).
        # Only a primary-card borrow is "the primary server": a slot-card borrow
        # lives in its slot, and reporting it here would make the primary look occupied by a
        # model running on another card.
        ft = _ft_state()
        if ft and str(ft.get("device")) == PRIMARY_GPU:
            state.update(running=True, pid=ft["pid"], model=ft.get("model"),
                         profile=ft.get("profile"), backend="freetoken")
            return state
        try:
            r = subprocess.run(
                ["pgrep", "-f",
                 f"{FT_BIN_DEFAULT.parent}/python.*ft serve.*--port {FT_PORT}"],
                capture_output=True, text=True, timeout=5)
            first = next((l for l in r.stdout.strip().split("\n") if l.strip()), "")
            if first and "pgrep" not in first:
                state.update(running=True, pid=int(first.split()[0]),
                             external=True, backend="freetoken")
                return state
        except Exception:
            pass
        return state
    state["running"] = True
    state["pid"] = pid
    model = parse_model_from_cmdline(cmdline)
    state["model"] = model
    # Detect backend from the live cmdline as a fallback signal.
    if cmdline and "vllm.entrypoints" in cmdline:
        state["backend"] = "vllm"
    elif cmdline and "ds4-server" in cmdline:
        state["backend"] = "ds4"

    # State file is authoritative when PID matches (model-swap launched it)
    saved = _read_state_file()
    if saved and (saved.get("pid") == pid or saved.get("model") == model):
        state["profile"] = saved.get("profile")
        state["backend"] = saved.get("backend", state["backend"])
        return state

    # Fall back to scanning profiles by model filename
    if model:
        profile = match_profile_to_model(model)
        if profile:
            state["profile"] = profile
        else:
            state["external"] = True
    return state


# ── GPU checks ───────────────────────────────────────────────────────────────

def check_cuda_init():
    """Test CUDA runtime initialization. Returns (ok, message)."""
    try:
        lib = ctypes.cdll.LoadLibrary("libcuda.so.1")
        ret = lib.cuInit(0)
        if ret == 0:
            return True, "cuInit OK"
        return False, f"cuInit returned {ret} — system may need a cold boot after suspend/resume"
    except Exception as e:
        return False, f"CUDA library load failed: {e}"


def get_gpu_stats():
    """Get GPU stats via nvidia-smi. Returns dict or None."""
    try:
        result = subprocess.run(
            ["nvidia-smi",
             "--query-gpu=name,memory.used,memory.total,memory.free,utilization.gpu,temperature.gpu",
             "--format=csv,noheader,nounits",
             f"--id={GPU_UUID}"],
            capture_output=True, text=True, timeout=10,
        )
        if result.returncode != 0:
            return None
        parts = [p.strip() for p in result.stdout.strip().split(",")]
        if len(parts) >= 6:
            return {
                "name": parts[0],
                "vram_used_mb": int(parts[1]),
                "vram_total_mb": int(parts[2]),
                "vram_free_mb": int(parts[3]),
                "utilization_pct": int(parts[4]),
                "temperature_c": int(parts[5]),
            }
    except Exception:
        pass
    return None


def check_gpu_uuid():
    """Check that the target GPU is present. Returns (ok, message)."""
    try:
        result = subprocess.run(
            ["nvidia-smi", "--query-gpu=uuid", "--format=csv,noheader"],
            capture_output=True, text=True, timeout=10,
        )
        if GPU_UUID in result.stdout:
            return True, f"{PRIMARY_LABEL} UUID confirmed"
        return False, f"{PRIMARY_LABEL} UUID {GPU_UUID} not found"
    except Exception as e:
        return False, f"nvidia-smi failed: {e}"


def gpu_preflight():
    """Run full GPU pre-flight. Returns (ok, messages)."""
    messages = []

    ok, msg = check_cuda_init()
    messages.append(("CUDA init", ok, msg))
    if not ok:
        return False, messages

    ok, msg = check_gpu_uuid()
    messages.append(("GPU UUID", ok, msg))
    if not ok:
        return False, messages

    stats = get_gpu_stats()
    if stats:
        if stats["temperature_c"] > 85:
            messages.append(("Temperature", False, f"{stats['temperature_c']}°C — too hot (>85°C)"))
            return False, messages
        messages.append(("Temperature", True, f"{stats['temperature_c']}°C"))
        messages.append(("VRAM", True, f"{stats['vram_free_mb']}MiB free / {stats['vram_total_mb']}MiB total"))
    else:
        messages.append(("GPU stats", False, "Could not query nvidia-smi"))

    return True, messages


# ── Server health ────────────────────────────────────────────────────────────

def check_health(timeout_s=2, base_url=None):
    """Check /health, falling back to /v1/models. Returns (healthy, status_text).

    ds4-server 404s /health (no such endpoint) but serves /v1/models, and it
    binds its socket only after the engine is fully loaded — so /v1/models 200
    means model resident. llama/vLLM answer /health and short-circuit; server
    down is connection-refused on the first probe (no double-timeout).
    base_url: non-8012 upstream (freetoken's own port)."""
    base = base_url or f"http://{HOST}:{PORT}"
    for url in (f"{base}/health", f"{base}/v1/models"):
        try:
            with urlopen(Request(url), timeout=timeout_s) as resp:
                if resp.status == 200:
                    return True, "healthy"
                return False, f"HTTP {resp.status}"
        except HTTPError:
            continue  # endpoint missing (ds4's /health) — try /v1/models
        except Exception:
            return False, "unreachable"  # conn refused/timeout = server down
    return False, "unreachable"


def get_server_model_info():
    """Query /v1/models for loaded model info. Returns dict or None."""
    try:
        req = Request(MODELS_URL)
        with urlopen(req, timeout=3) as resp:
            data = json.loads(resp.read())
        if data.get("data"):
            entry = data["data"][0]
            return {
                "id": entry.get("id", "unknown"),
                "meta": entry.get("meta", {}),
            }
    except Exception:
        pass
    return None


def wait_for_health(timeout_s=30, pid=None, base_url=None):
    """Poll /health until healthy or timeout. Returns (ok, elapsed_s, reason).
    reason: 'healthy', 'timeout', or 'process_died'.
    If pid is given, bail early when the process dies (VRAM crash, etc.)."""
    start = time.time()
    proc = _SERVER_PROCS.get(pid) if pid is not None else None
    while time.time() - start < timeout_s:
        # Fast-fail if the server process died (e.g. CUDA allocation failure).
        # Use proc.poll() (waitpid WNOHANG under the hood) when we launched the
        # process ourselves — os.kill(pid, 0) alone still succeeds against an
        # unreaped zombie, so it never observes the crash and this loop would
        # silently burn the full timeout instead of failing fast.
        if proc is not None:
            if proc.poll() is not None:
                verbose(f"Server PID {pid} died during health wait (exit {proc.returncode})")
                return False, round(time.time() - start, 1), "process_died"
        elif pid is not None:
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                verbose(f"Server PID {pid} died during health wait")
                return False, round(time.time() - start, 1), "process_died"
        ok, _ = check_health(timeout_s=2, base_url=base_url)
        if ok:
            return True, round(time.time() - start, 1), "healthy"
        time.sleep(0.5)
    return False, round(time.time() - start, 1), "timeout"


# ── Process management ───────────────────────────────────────────────────────

def kill_server(pid=None):
    """Kill llama-server. Returns (killed, message)."""
    if pid is None:
        pid, _ = find_server_process()
    if pid is None:
        return True, "No server running"

    verbose(f"Sending SIGTERM to PID {pid}")
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return True, "Process already gone"

    for _ in range(20):
        time.sleep(0.5)
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return True, f"Stopped (PID {pid})"

    verbose(f"SIGTERM timeout, sending SIGKILL to PID {pid}")
    try:
        os.kill(pid, signal.SIGKILL)
        time.sleep(1)
    except ProcessLookupError:
        pass
    return True, f"Force-killed (PID {pid})"


def build_command(profile):
    """Build the server command line from profile, dispatching on backend."""
    if _detect_backend(profile) == "vllm":
        return _build_vllm_cmd(profile)
    if _detect_backend(profile) == "freetoken":
        return _build_ft_cmd(profile)
    if _detect_backend(profile) == "ds4":
        return _build_ds4_cmd(profile)
    return _build_llama_cmd(profile)


def _build_llama_cmd(profile):
    """Build llama-server command line from profile."""
    binary = resolve_binary(profile)
    model_path = resolve_model_path(profile)
    cmd = [
        str(binary),
        "--model", str(model_path),
        "--host", HOST,
        "--port", str(PORT),
        "--device", DEVICE,
        "--metrics",  # always expose Prometheus /metrics for the system monitor
    ]

    params = profile.get("params", {})
    for key, flag in PARAM_MAP.items():
        if key in params:
            cmd.extend([flag, str(params[key])])

    for key, flag in BOOL_FLAGS.items():
        if params.get(key) and flag not in cmd:
            cmd.append(flag)

    if profile.get("kv_persist"):
        KV_SAVE_DIR.mkdir(parents=True, exist_ok=True)
        cmd.extend(["--slot-save-path", str(KV_SAVE_DIR)])

    for arg in profile.get("extra_args", []):
        cmd.append(str(arg))

    return cmd


def _build_vllm_cmd(profile):
    """Build vLLM OpenAI-API-server command line from profile.

    model: HF repo ID or absolute local dir. vllm_params: maps to --flags.
    Serves the same OpenAI-compatible API on the same HOST:PORT as llama.
    """
    model = profile["model"]
    vp = profile.get("vllm_params", {})
    # Serve under the profile short-name, the model id, AND the normalized
    # basename. llama.cpp ignores the request `model` field, so callers address
    # servers by profile name OR by the contract-derived basename
    # (`model.rsplit('/')[-1]`, matching the contract models{} map keys). vLLM
    # validates the field strictly and 404s on mismatch (basename "Qwen3-8B"
    # matches neither "qwen3-8b-vllm" nor "Qwen/Qwen3-8B"). Register all three,
    # deduped.
    served_names = list(dict.fromkeys(
        n for n in (profile.get("_name"), str(model),
                    str(model).rsplit("/", 1)[-1]) if n))
    cmd = [
        str(VLLM_PYTHON), "-m", "vllm.entrypoints.openai.api_server",
        "--model", str(model),
        "--served-model-name", *served_names,
        "--host", HOST,
        "--port", str(PORT),
        "--gpu-memory-utilization", str(vp.get("gpu_memory_utilization", 0.95)),
        "--max-model-len", str(vp.get("max_model_len", 131072)),
    ]
    if vp.get("tensor_parallel_size"):
        cmd += ["--tensor-parallel-size", str(vp["tensor_parallel_size"])]
    if vp.get("quantization"):
        cmd += ["--quantization", str(vp["quantization"])]
    if vp.get("kv_cache_dtype"):
        cmd += ["--kv-cache-dtype", str(vp["kv_cache_dtype"])]
    if vp.get("enable_chunked_prefill"):
        cmd += ["--enable-chunked-prefill"]
    if vp.get("max_num_seqs"):
        cmd += ["--max-num-seqs", str(vp["max_num_seqs"])]
    if vp.get("cpu_offload_gb"):
        cmd += ["--cpu-offload-gb", str(vp["cpu_offload_gb"])]
    # Tool calling: llama.cpp slots run --jinja (native tool-call parsing), but
    # vLLM requires explicit enablement — without these flags every request with
    # tool_choice="auto" 400s ("auto" tool choice requires --enable-auto-tool-choice
    # and --tool-call-parser), which breaks any agentic client. The hermes
    # parser covers the Qwen-family tool-call format; override per-profile via
    # vllm_params.tool_call_parser.
    cmd += ["--enable-auto-tool-choice",
            "--tool-call-parser", str(vp.get("tool_call_parser", "hermes"))]
    for arg in profile.get("extra_args", []):
        cmd.append(str(arg))
    return cmd


def _build_ds4_cmd(profile):
    """Build ds4-server (NeutronStar) command line. GGUF like llama, but its
    own flag vocabulary (ds4_params) and DS4_CUDA_* tuning via profile env."""
    binary = resolve_binary(profile)
    model_path = resolve_model_path(profile)
    cmd = [str(binary), "--model", str(model_path),
           "--host", HOST, "--port", str(PORT), "--cuda"]
    dp = profile.get("ds4_params", {})
    for key, flag in DS4_PARAM_MAP.items():
        if key in dp:
            cmd.extend([flag, str(dp[key])])
    for key, flag in DS4_BOOL_FLAGS.items():
        if dp.get(key) and flag not in cmd:
            cmd.append(flag)
    for arg in profile.get("extra_args", []):
        cmd.append(str(arg))
    return cmd


def _build_ft_cmd(profile):
    """Build `ft serve` command line. FreeToken serves on its own pinned port
    (FT_PORT), not 8012. model: local file (GGUF or HF-layout dir) or HF repo
    ID. ft_params maps to --flags (ds4_params style)."""
    binary = resolve_binary(profile)
    model_path = resolve_model_path(profile)
    served_name = profile.get("served_name") or \
        str(profile["model"]).rsplit("/", 1)[-1].removesuffix(".gguf")
    cmd = [str(binary), "serve",
           "--model", str(model_path),
           "--served-model-name", served_name,
           "--port", str(profile.get("ft_port", FT_PORT))]
    fp = profile.get("ft_params", {})
    for key, flag in FT_PARAM_MAP.items():
        if key in fp:
            cmd.extend([flag, str(fp[key])])
    for arg in profile.get("extra_args", []):
        cmd.append(str(arg))
    return cmd


def start_server(profile, dry_run=False, pool_slot=None, cuda_devices=None, log_file=None):
    """Launch a server with profile config. Returns (pid, command).
    pool_slot: optional slot dict — injects its CUDA_VISIBLE_DEVICES and extra_args.
    cuda_devices: explicit CUDA_VISIBLE_DEVICES override (freetoken borrows).
    log_file: log target (freetoken keeps its own log)."""
    # Respect a live GPU lease (e.g. a training job on the primary card).
    # slot_ensure enforces leases for slots; this covers the primary path.
    if not dry_run:
        held = _lease_conflict({"cuda_devices": pool_slot["cuda_devices"] if pool_slot else (cuda_devices or GPU_UUID)})
        if held:
            error(f"GPU leased by '{held['holder']}' ({held['fresh_s']}s ago); "
                  f"release the lease or wait before starting a server")
            sys.exit(3)
    cmd = build_command(profile)
    # Inject pool slot's extra args, but profile params win on conflict.
    # skip llama-only flags (--split-mode, --tensor-split) for vLLM; vLLM uses --tensor-parallel-size instead.
    _LLAMA_ONLY_FLAGS = {"--split-mode", "--tensor-split"}
    non_llama = _detect_backend(profile) != "llama"  # vLLM and ds4 both exit on these flags
    # Pool llama loads: _build_llama_cmd hardcodes --device CUDA0 (single GPU), so
    # --split-mode layer has nothing to split across → OOM on a >1-card pool. With
    # CUDA_VISIBLE_DEVICES pinned to the pool's UUIDs, llama sees them as CUDA0..N;
    # widen --device to the full pool device list. (vLLM/ds4 don't take --device.)
    if pool_slot and not non_llama and "--device" in cmd:
        n = len(pool_slot["cuda_devices"].split(","))
        cmd[cmd.index("--device") + 1] = ",".join(f"CUDA{i}" for i in range(n))
    if pool_slot:
        skip_next = False
        for i, arg in enumerate(pool_slot.get("extra_args", [])):
            if skip_next:
                skip_next = False
                continue
            # If this flag is already in cmd (set by profile), skip it and its value
            if arg.startswith("--") and arg in cmd:
                skip_next = True
                continue
            # Skip llama-only flags for non-llama backends (vLLM, ds4)
            if non_llama and arg in _LLAMA_ONLY_FLAGS:
                skip_next = True
                continue
            cmd.append(str(arg))
    verbose(f"Command: {' '.join(cmd)}")

    if dry_run:
        return None, cmd

    log_fd = open(log_file or LOG_FILE, "a")
    log_fd.write(f"\n{'='*60}\n")
    log_fd.write(f"model-swap: starting {profile['model']} at {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
    log_fd.write(f"command: {' '.join(cmd)}\n")
    log_fd.write(f"{'='*60}\n")
    log_fd.flush()

    # Build server environment: inherit parent env, pin GPU(s) by UUID.
    server_env = os.environ.copy()
    server_env["CUDA_DEVICE_ORDER"] = "PCI_BUS_ID"
    server_env["CUDA_VISIBLE_DEVICES"] = pool_slot["cuda_devices"] if pool_slot else (cuda_devices or GPU_UUID)
    if "cuda_device_order" in profile:
        server_env["CUDA_DEVICE_ORDER"] = profile["cuda_device_order"]
    if _detect_backend(profile) == "vllm":
        # vLLM rejects UUIDs in CUDA_VISIBLE_DEVICES — convert to PCI indices
        uuids = server_env["CUDA_VISIBLE_DEVICES"].split(",")
        server_env["CUDA_VISIBLE_DEVICES"] = ",".join(
            _uuid_to_pci(u.strip()) for u in uuids
        )

    # Profile-declared env (e.g. DS4_CUDA_HOST_EXPERT_CACHE_GB) — after device
    # pinning so a profile can override anything deliberately.
    for k, v in profile.get("env", {}).items():
        server_env[str(k)] = str(v)

    # ds4: ensure the KV checkpoint dir exists (here, not in _build_ds4_cmd,
    # so --dry-run stays side-effect free)
    if _detect_backend(profile) == "ds4":
        kv_dir = profile.get("ds4_params", {}).get("kv_disk_dir")
        if kv_dir:
            Path(kv_dir).mkdir(parents=True, exist_ok=True)

    proc = subprocess.Popen(
        cmd,
        stdout=log_fd,
        stderr=log_fd,
        start_new_session=True,
        env=server_env,
    )
    _SERVER_PROCS[proc.pid] = proc
    return proc.pid, cmd


def save_state(profile_name, model, pid, ctx_size=None, backend="llama"):
    """Write active state to JSON file and update gpu-contract.yaml."""
    state = {
        "profile": profile_name,
        "model": model,
        "pid": pid,
        "backend": backend,
        "ctx_size": ctx_size,
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S"),
    }
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)
    write_contract()


def _primary_load_in_progress():
    """True while a live load lock targets the primary card. Published as
    `primary.state: loading` so a yielding consumer (anything that steps aside
    while the primary loads) frees the card BEFORE the VRAM check, not after. Pool and FreeToken loads take the same lock but land
    elsewhere (FreeToken yields via its own reservation), so they don't count."""
    lock = _read_load_lock()
    if not lock:
        return False
    prof, _ = load_profile(lock.get("profile"))
    if not prof:
        return True  # mid-write/unknown lock — claim the card, the safe side
    return not prof.get("pool") and _detect_backend(prof) != "freetoken"


def write_contract():
    """Write ~/gpu-contract.yaml — single source of truth for all GPU consumers.

    Every harness, pipeline, and script reads this instead of hardcoding ports.
    model-swap is the ONLY writer. Everyone else is a reader.
    """
    # Primary GPU state
    cur = get_current_state()
    # Watchdog honesty: profiles with idle_stop false (ds4 has no /metrics)
    # never self-free — the contract must not promise a reaper.
    _idle_timeout = PRIMARY_IDLE_TIMEOUT_S
    if cur.get("profile"):
        _prof, _ = load_profile(cur["profile"])
        if _prof and _prof.get("idle_stop", True) is False:
            _idle_timeout = None
    primary = {
        "port": PORT,
        "backend": cur.get("backend", "llama"),
        "device": DEVICE,
        "gpu": PRIMARY_LABEL,
        "state": "running" if cur["running"] else ("loading" if _primary_load_in_progress() else "stopped"),
        "profile": cur.get("profile"),
        "model": cur.get("model"),
        "pid": cur.get("pid"),
        "idle_timeout": _idle_timeout,  # in-memory watchdog; None = never self-frees
        "activity_file": None,
    }
    # `primary` means "how you reach the primary card", and during a FreeToken borrow that
    # is FreeToken's own port — not 8012, where nothing is listening. Reporting
    # 8012 here made gpu_contract.primary_port()/primary_url()/primary_state()
    # hand every consumer a dead endpoint while the borrow was live; the models
    # map alone could not fix that, because a consumer's acquire() may fall back to
    # primary_url() whenever the profile it asks for isn't in the map.
    # `state` stays "running" on purpose: the card IS serving, and every consumer
    # that gates on state == "running" must keep working through a borrow. The
    # borrow is signalled additively via `borrowed_by`.
    # Only a primary-card borrow touches `primary`; a slot-card borrow belongs to its
    # slot and must leave the primary entry describing what the primary is really doing.
    _ft_primary = _ft_state()
    if _ft_primary and str(_ft_primary.get("device")) == PRIMARY_GPU:
        primary.update(port=_ft_primary["port"], backend="freetoken",
                       state="running", profile=_ft_primary.get("profile"),
                       model=_ft_primary.get("served_name"),
                       pid=_ft_primary["pid"], idle_timeout=None,
                       borrowed_by="freetoken")

    # Configured slots (single cards and pools).
    # A slot is "running as itself" only if its state file exists (shared-port
    # disambiguation — two slots may share a port).
    def _slot_contract(slot):
        running, pid, model = False, None, None
        if slot["state"].exists():
            ok, _ = slot_check_health(slot, timeout_s=2)
            running = ok
            pid, _ = slot_find_process(slot)
            if running:
                try:
                    with urlopen(Request(slot["models_url"]), timeout=2) as r:
                        data = json.loads(r.read())
                    if data.get("data"):
                        model = data["data"][0].get("id")
                except Exception:
                    pass
        return {
            "name": slot["name"],
            "port": slot["port"],
            "device": slot["cuda_devices"],
            "gpu": slot["gpu_label"],
            "vram_mb": slot["vram_mb"],
            "state": "running" if running else "stopped",
            "model": model,
            "pid": pid,
            "activity_file": str(slot["activity"]),
            "idle_timeout": _slot_idle_timeout(slot),
        }

    slots = {name: _slot_contract(s) for name, s in ALL_SLOTS.items()}
    secondary = dict(slots["secondary"]) if "secondary" in slots else None  # back-compat alias (copy: no YAML anchor)

    # Reservation state (if active and not expired)
    reservation_info = None
    if RESERVATION_FILE.exists():
        try:
            with open(RESERVATION_FILE) as f:
                res = json.load(f)
            ts = res.get("timestamp", "")
            timeout_s = res.get("timeout_s", 3600)
            try:
                from datetime import datetime as _dt
                created = _dt.strptime(ts, "%Y-%m-%dT%H:%M:%S")
                age = (_dt.now() - created).total_seconds()
                if age <= timeout_s:
                    reservation_info = {
                        "reason": res.get("reason"),
                        "devices": res.get("devices"),
                        "since": ts,
                        "expires_in_s": int(timeout_s - age),
                    }
            except ValueError:
                reservation_info = {"reason": res.get("reason"), "since": ts}
        except Exception:
            pass

    # Flat model→url map for gateway routing. endpoint_for_model() checks this
    # FIRST, so it resolves every running slot — including pools, which the legacy
    # primary/secondary fallback never sees. Keyed by both the
    # raw served id and its normalized basename (rsplit '/', strip .gguf) so a
    # consumer sending either form matches. Purely additive: no existing key changes.
    def _norm_model_id(mid):
        return mid.rsplit("/", 1)[-1].replace(".gguf", "") if mid else mid

    models_map = {}
    ft = _ft_state()
    if primary.get("model") and primary.get("state") == "running" \
            and primary.get("backend") != "freetoken":
        _u = f"http://127.0.0.1:{PORT}"
        models_map[primary["model"]] = _u
        models_map[_norm_model_id(primary["model"])] = _u
    if ft:
        # FreeToken serves on its own port — the gateway reads only this entry
        # (no new top-level contract section). Keyed by the profile
        # stem too (same both-forms rule as the gguf entries) so a consumer
        # querying endpoint_for_model(profile) — e.g. a launcher's acquire —
        # resolves the ft port instead of falling back to the borrowed-away
        # primary.
        _u = f"http://127.0.0.1:{ft['port']}"
        models_map[ft["served_name"]] = _u
        if ft.get("profile") and ft["profile"] != ft["served_name"]:
            models_map[ft["profile"]] = _u
    for _s in slots.values():
        if _s.get("model") and _s.get("state") == "running":
            _u = f"http://127.0.0.1:{_s['port']}"
            models_map[_s["model"]] = _u
            models_map[_norm_model_id(_s["model"])] = _u

    contract = {
        "_generated_by": "model-swap",
        "_warning": "Auto-generated. Do not edit. Read by all GPU consumers.",
        "_updated": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "models": models_map,
        **({"gateway": CFG["gateway"]} if CFG.get("gateway") else {}),
        "primary": primary,
        "secondary": secondary,
        "slots": slots,
        **{name: _sidecar_contract(sc) for name, sc in (CFG.get("sidecars") or {}).items()},
        "reservation": reservation_info,
        "lease": _lease_contract(),
    }

    # Atomic write: tmp + replace, so concurrent writers (e.g. parallel primary+slot
    # loads) can never leave a half-written, unparseable contract. Last-writer-wins;
    # any transient staleness self-heals on the next state change.
    tmp = CONTRACT_FILE.with_suffix(".yaml.tmp")
    with open(tmp, "w") as f:
        yaml.dump(contract, f, default_flow_style=False, sort_keys=False)
    os.replace(tmp, CONTRACT_FILE)
    verbose(f"Contract written: {CONTRACT_FILE}")


# ── Generic GPU slot management ─────────────────────────────────────────────
# All slot functions take a slot dict from ALL_SLOTS. No per-GPU copy-paste.

def slot_find_process(slot):
    """Find running llama-server on slot's port. Returns (pid, cmdline) or (None, None)."""
    try:
        result = subprocess.run(
            ["pgrep", "-a", "-f", f"llama-server.*--port {slot['port']}"],
            capture_output=True, text=True, timeout=5,
        )
        for line in result.stdout.strip().split("\n"):
            if not line.strip():
                continue
            parts = line.split(None, 1)
            if len(parts) == 2:
                pid = int(parts[0])
                cmdline = parts[1]
                if "pgrep" not in cmdline:
                    return pid, cmdline
    except Exception:
        pass
    return None, None


def slot_check_health(slot, timeout_s=2):
    """Check slot's llama-server /health endpoint."""
    try:
        req = Request(slot["health_url"])
        with urlopen(req, timeout=timeout_s) as resp:
            if resp.status == 200:
                return True, "healthy"
            return False, f"HTTP {resp.status}"
    except Exception:
        return False, "unreachable"


def slot_touch_activity(slot):
    """Touch activity file to keep idle watchdog alive."""
    try:
        with open(slot["activity"], "w") as f:
            f.write(str(int(time.time())))
    except OSError:
        pass


def slot_start(slot, gguf_path, ctx_size=32768, profile_extra_args=None, binary=None,
               profile_params=None):
    """Launch llama-server on a GPU slot. Returns (pid, cmd).

    binary: profile-resolved server binary. Historically the slot path
    hardcoded LLAMA_BIN_DEFAULT (stock llama.cpp), so a profile pinning a
    custom binary (e.g. a patched llama.cpp fork) ran the stock binary
    on slots/pools and crashed on load while the primary slot used the
    override. Falls back to LLAMA_BIN_DEFAULT when unset.

    profile_extra_args: the PROFILE's extra_args (e.g. --chat-template-file).
    Historically only slot["extra_args"] (pool config) was appended, so any
    per-profile llama flags were silently DROPPED on the slot path — a profile
    with a template override ran the embedded template on slots/pools while
    running the override on primary. Appended last so profile flags win on
    conflicts.
    """
    cmd = [
        str(binary or LLAMA_BIN_DEFAULT),
        "--model", str(gguf_path),
        "--host", HOST,
        "--port", str(slot["port"]),
        "-ngl", "99",
        "--ctx-size", str(ctx_size),
        "--flash-attn", "on",
        "--cache-type-k", "q4_0",
        "--cache-type-v", "q4_0",
        "--jinja",  # use the GGUF's embedded chat template so native tool-call
                    # parsing works (matches the primary slot). Forcing
                    # --chat-template chatml here silently disabled tool_calls on
                    # slot servers -> agentic/chain scored ~0 for every model that
                    # ran on a pool/solo slot.
        "-np", "1",
        "--metrics",  # expose Prometheus /metrics so the system monitor sees slot/pool inference
        "-fit", "off",  # we pass an explicit --tensor-split; llama.cpp's auto-fit probe is
                        # redundant and can spin for minutes (and wedge the CUDA context) on
                        # multi-GPU pools. Disable it — the split below is authoritative.
    ] + slot["extra_args"]
    # Profile params (PARAM_MAP/BOOL_FLAGS) — historically DROPPED on the slot
    # path (only extra_args survived), so spec/batch/KV keys in params: silently
    # fell back to the slot defaults above (bug: gemma4-31b-qat-mtp lost
    # --spec-type/--spec-draft-n-max, ran plain decode). llama.cpp arg parsing
    # is last-wins, so append after the hardcoded defaults AND the pool slot's
    # extra_args (matching start_server's profile-wins convention for
    # split_mode/tensor_split); profile extra_args go last, staying
    # authoritative on any conflict.
    pp = profile_params or {}
    for key, flag in PARAM_MAP.items():
        if key == "ctx_size":
            continue  # resolved into the ctx_size argument by the caller
        if key in pp:
            cmd.extend([flag, str(pp[key])])
    for key, flag in BOOL_FLAGS.items():
        if pp.get(key) and flag not in cmd:
            cmd.append(flag)
    cmd += list(profile_extra_args or [])

    log_fd = open(slot["log"], "a")
    log_fd.write(f"\n{'='*60}\n")
    log_fd.write(f"model-swap: starting {slot['name']} at {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
    log_fd.write(f"command: {' '.join(cmd)}\n")
    log_fd.write(f"{'='*60}\n")
    log_fd.flush()

    env = os.environ.copy()
    env["CUDA_DEVICE_ORDER"] = "PCI_BUS_ID"
    env["CUDA_VISIBLE_DEVICES"] = slot["cuda_devices"]

    proc = subprocess.Popen(
        cmd, stdout=log_fd, stderr=log_fd,
        start_new_session=True, env=env,
    )
    return proc.pid, cmd


def _slot_idle_timeout(slot, default=None):
    """Idle timeout the running slot was ensured with (state file), else `default`
    (else the slot's configured value)."""
    try:
        return int(json.loads(slot["state"].read_text())["idle_timeout"])
    except (OSError, ValueError, KeyError, TypeError):
        return slot["idle_timeout"] if default is None else default


def slot_save_state(slot, model, pid, ctx_size=None):
    """Write slot GPU state."""
    state = {
        "model": model, "pid": pid, "ctx_size": ctx_size,
        "idle_timeout": slot["idle_timeout"],
        "slot": slot["name"],
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S"),
    }
    with open(slot["state"], "w") as f:
        json.dump(state, f, indent=2)
    with open(slot["pid_file"], "w") as f:
        f.write(str(pid))
    write_contract()


def slot_stop(slot):
    """Stop a slot's llama-server."""
    pid, _ = slot_find_process(slot)
    if pid is None:
        return True, "Not running"
    killed, msg = kill_server(pid)
    for f in [slot["state"], slot["pid_file"], slot["activity"]]:
        try:
            f.unlink(missing_ok=True)
        except Exception:
            pass
    write_contract()
    return killed, msg


def _slot_stop_conflicting(slot):
    """Stop any slot that conflicts (shares a port or GPU) with the target slot.

    A pool conflicts with every single-card slot on its cards, and slots that
    share a port conflict with each other.
    A pool that includes the primary card conflicts with every slot on its cards
    AND the primary server — that last one is evicted here too.
    """
    target_devs = set(slot["cuda_devices"].split(","))

    # If this slot claims the primary card, the primary server must go first.
    if GPU_UUID in target_devs:
        lock = _read_load_lock()
        if lock and lock.get("pid") != os.getpid():
            error(f"Primary load in progress (pid {lock['pid']}, profile "
                  f"{lock.get('profile')}) — cannot evict the {PRIMARY_GPU} for {slot['name']}; retry later")
            sys.exit(3)
        cur = get_current_state()
        if cur["running"]:
            info(f"Stopping primary {PRIMARY_GPU} server (PID {cur['pid']}) to free the {PRIMARY_GPU} for {slot['name']}...")
            kill_server(cur["pid"])
            time.sleep(1)
            write_contract()

    for name, other in ALL_SLOTS.items():
        if other is slot:
            continue
        other_devs = set(other["cuda_devices"].split(","))
        if other["port"] == slot["port"] or target_devs & other_devs:
            # State file proves `other` actually owns its port/GPUs. Without it,
            # slot_find_process (by-port) can match a port-sharer and kill it.
            if not other["state"].exists():
                continue
            pid, _ = slot_find_process(other)
            if pid:
                info(f"Stopping conflicting {other['name']} (port {other['port']})...")
                slot_stop(other)


def _stop_slots_holding_primary():
    """Evict any slot that holds the primary card before the primary server starts.

    Only a pool that includes the primary card can do this; the check is by UUID. A slot "owns" the primary card only if its state
    file exists (shared-port disambiguation, same rule as _slot_stop_conflicting)."""
    stopped = []
    for name, slot in ALL_SLOTS.items():
        if GPU_UUID in set(slot["cuda_devices"].split(",")) and slot["state"].exists():
            info(f"  Stopping {slot['name']} (holds the {PRIMARY_GPU}) to free it...")
            slot_stop(slot)
            stopped.append(slot["name"])
    return stopped


def slot_ensure(slot, gguf_path=None, ctx_size=32768, profile_extra_args=None, binary=None,
                profile_params=None, idle_timeout=None):
    """Ensure slot server is running. Start if needed, noop if healthy.

    Default model: config `slot_default_gguf:` unless --gguf/--profile names one.
    idle_timeout (s) overrides the slot default for this server's watchdog, so a
    short-lived consumer can hand the card back fast (e.g. so a yielding background job resumes).
    """
    default_idle = slot["idle_timeout"]
    if idle_timeout:
        slot["idle_timeout"] = int(idle_timeout)
    # Health is by-port; two slots may share a port, so a healthy
    # response alone can't prove THIS slot owns the port. The per-slot state
    # file disambiguates: only the live slot's state file exists.
    ok, _ = slot_check_health(slot, timeout_s=2)
    if ok and slot["state"].exists():
        # `ensure --profile X` must guarantee X is what's actually SERVED. This
        # used to return "Already running" for any healthy server on the slot,
        # so ensuring a new profile onto a live slot silently kept serving the
        # PREVIOUS model — callers then benchmark the wrong weights under the
        # right label. Compare the requested gguf against the recorded one and
        # swap when they differ.
        running = None
        try:
            running = json.loads(slot["state"].read_text()).get("model")
        except (OSError, ValueError):
            pass
        want = str(gguf_path) if gguf_path else None
        if want and running and Path(running) != Path(want):
            info(f"{slot['name']}: serving {Path(running).name}, "
                 f"need {Path(want).name} — swapping")
            slot_stop(slot)
        else:
            slot_touch_activity(slot)
            pid, _ = slot_find_process(slot)
            if idle_timeout and _slot_idle_timeout(slot, default_idle) != slot["idle_timeout"]:
                # Re-arm the watchdog (it kills its predecessor) and record the new value.
                try:
                    st = json.loads(slot["state"].read_text())
                    slot_save_state(slot, st.get("model"), st.get("pid", pid), st.get("ctx_size"))
                except (OSError, ValueError):
                    pass
                _start_slot_watchdog(slot)
            return True, f"Already running (PID {pid})"

    # Respect another holder's live lease on these GPUs. Refuse rather
    # than evict their job mid-flight (no surprise kills); the TTL frees it.
    held = _lease_conflict(slot)
    if held:
        return False, (f"{slot['name']} leased by '{held['holder']}' "
                       f"({held['fresh_s']}s ago, {held['ttl_remaining_s']}s TTL left); "
                       "release or wait")

    # Stop anything that would conflict (pool vs single card, shared ports)
    _slot_stop_conflicting(slot)

    # Resolve model path
    if gguf_path is None:
        pattern = CFG.get("slot_default_gguf")
        if not pattern:
            return False, "no slot_default_gguf in config — pass --gguf or --profile"
        candidates = sorted(glob.glob(os.path.expanduser(pattern), recursive=True))
        if not candidates:
            return False, f"slot_default_gguf matches nothing: {pattern} (pass --gguf or --profile)"
        gguf_path = Path(candidates[0])

    info(f"Starting {slot['name']} ({Path(gguf_path).name}, port {slot['port']}, {slot['vram_mb']}MB)...")
    pid, cmd = slot_start(slot, gguf_path, ctx_size, profile_extra_args=profile_extra_args,
                          binary=binary, profile_params=profile_params)

    # Wait for health — multi-GPU needs much longer on cold page cache (42GB+ from disk).
    # DO NOT kill on timeout — killing mid-CUDA-operation wedges the nvidia driver context
    # and leaves VRAM unreclaimable (requires reboot). Just warn and exit.
    timeout = 300 if "," in slot["cuda_devices"] else 120
    healthy, elapsed = False, 0
    start = time.time()
    while time.time() - start < timeout:
        ok, _ = slot_check_health(slot, timeout_s=2)
        if ok:
            healthy = True
            elapsed = round(time.time() - start, 1)
            break
        time.sleep(0.5)

    if not healthy:
        # do NOT kill here — SIGKILL during multi-GPU CUDA mmap wedges the
        # nvidia driver (kernel thread loops at 60% CPU, VRAM unreclaimable until reboot).
        # Leave the process running; it may still come up. User can kill manually if truly stuck.
        return False, f"Health check failed after {timeout}s (process left running, PID {pid})"

    slot_save_state(slot, str(gguf_path), pid, ctx_size)
    slot_touch_activity(slot)
    _start_slot_watchdog(slot)
    return True, f"Ready (PID {pid}, {elapsed}s)"


def _start_slot_watchdog(slot):
    """Fork an idle watchdog for a GPU slot."""
    watchdog_tag = f"model-swap slot-idle-{slot['name']}"
    try:
        result = subprocess.run(
            ["pgrep", "-f", watchdog_tag], capture_output=True, text=True,
        )
        for line in result.stdout.strip().splitlines():
            wpid = int(line.strip())
            if wpid != os.getpid():
                try:
                    os.kill(wpid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
    except Exception:
        pass

    child = os.fork()
    if child > 0:
        verbose(f"{slot['name']} idle watchdog started (PID {child}, {slot['idle_timeout']}s)")
        return

    # Child: detach
    devnull_fd = os.open(os.devnull, os.O_RDWR)
    os.dup2(devnull_fd, 0)
    os.dup2(devnull_fd, 1)
    os.dup2(devnull_fd, 2)
    if devnull_fd > 2:
        os.close(devnull_fd)
    os.setsid()
    sys.stdout = open(os.devnull, "w")
    sys.stderr = open(os.devnull, "w")

    # Tag this process for pgrep identification
    ctypes.CDLL("libc.so.6").prctl(15, watchdog_tag.encode(), 0, 0, 0)

    poll_s = 10
    # Requests reach the slot through the gateway, which never touches the
    # activity file, so new generated tokens count as activity too (otherwise
    # the timer runs from the last ensure, not the last request).
    last_tokens = _get_predicted_total(slot["port"])
    while True:
        time.sleep(poll_s)
        tokens = _get_predicted_total(slot["port"])
        if tokens is not None and tokens != last_tokens:
            last_tokens = tokens
            slot_touch_activity(slot)
        pid, _ = slot_find_process(slot)
        if pid is None:
            for f in [slot["state"], slot["pid_file"], slot["activity"]]:
                try:
                    f.unlink(missing_ok=True)
                except Exception:
                    pass
            os._exit(0)

        if slot["activity"].exists():
            try:
                last_active = int(slot["activity"].read_text().strip())
                idle = int(time.time()) - last_active
                if idle >= slot["idle_timeout"]:
                    # A live lease on this slot's GPUs counts as activity: the
                    # holder is renewing, so the card is claimed even if no
                    # request landed inside idle_timeout (a long bench axis).
                    # The lease TTL, not this watchdog, is the backstop.
                    if _lease_covers(slot):
                        continue
                    try:
                        req = Request(f"http://{HOST}:{slot['port']}/slots")
                        with urlopen(req, timeout=2) as resp:
                            slots_data = json.loads(resp.read())
                        if any(s.get("is_processing") for s in slots_data):
                            continue
                    except Exception:
                        pass
                    kill_server(pid)
                    for f in [slot["state"], slot["pid_file"], slot["activity"]]:
                        try:
                            f.unlink(missing_ok=True)
                        except Exception:
                            pass
                    try:
                        write_contract()
                    except Exception:
                        pass
                    os._exit(0)
            except (ValueError, OSError):
                pass


# ── Legacy wrappers (callers that still use the old names) ───────────────────
def find_secondary_process():
    return slot_find_process(SLOT_SECONDARY)

def check_secondary_health(timeout_s=2):
    return slot_check_health(SLOT_SECONDARY, timeout_s)

def secondary_touch_activity():
    slot_touch_activity(SLOT_SECONDARY)

def stop_secondary():
    return slot_stop(SLOT_SECONDARY)

# ── Commands ─────────────────────────────────────────────────────────────────

def _cmd_load_freetoken(args, profile):
    """FreeToken borrow/return lifecycle: reserve the device
    (snapshotting whatever it stops) → `ft serve` on its own port → poll
    /health → publish the contract models entry. Always a borrow: `stop`
    SIGTERMs ft and releases with restore, returning the card."""
    if _ft_state():
        error("FreeToken is already running — 'model-swap stop' first")
        return 3
    device = str(profile.get("device"))  # YAML parses a numeric name as int; GPU names are str
    ft_devices = _ft_devices()
    if device not in ft_devices:
        error(f"freetoken profile needs 'device': one of {sorted(ft_devices)} (got {device!r})")
        return 4
    cuda_dev, res_devices, slot_name = ft_devices[device]
    # Tell the kernel JIT which card it is actually building for (see
    # _gpu_arch). A profile may override it deliberately.
    if _gpu_arch(device):
        profile.setdefault("env", {}).setdefault("TVM_FFI_CUDA_ARCH_LIST",
                                                 _gpu_arch(device))
    # Box-wide FreeToken env (config `freetoken.env:`), e.g. allowing a JIT across
    # an nvcc/torch CUDA version split. A property of the machine, not of any one
    # model, so it lives in the config rather than in every profile. A profile may
    # still override.
    for k, v in FT_ENV.items():
        profile.setdefault("env", {}).setdefault(k, v)
    port = int(profile.get("ft_port", FT_PORT))
    served_name = profile.get("served_name") or \
        str(profile["model"]).rsplit("/", 1)[-1].removesuffix(".gguf")
    # First run = weight load + CUDA-graph capture — 30s would cut it off.
    timeout = args.timeout if args.timeout != 30 else FT_READY_TIMEOUT

    if args.dry_run:
        _, cmd = start_server(profile, dry_run=True, cuda_devices=cuda_dev)
        info(f"\n  Would run: {' '.join(cmd)}")
        return 0

    if not _acquire_load_lock(args.profile, ttl_s=timeout + 300):
        lock = _read_load_lock() or {}
        error(f"Another load in progress (pid {lock.get('pid')}, profile "
              f"{lock.get('profile')}) — retry when it finishes")
        return 6

    # Evict a llama server on the target card's slot BEFORE the reservation, so
    # the snapshot records it for release-restore (reserve itself stops the
    # primary + the secondary; any other slot's borrow would otherwise lose its model).
    extra_stopped = {}
    if slot_name and ALL_SLOTS[slot_name]["state"].exists():
        pid, _ = slot_find_process(ALL_SLOTS[slot_name])
        if pid:
            info(f"  Stopping {slot_name} slot (PID {pid}) to free {device}...")
            slot_stop(ALL_SLOTS[slot_name])
            extra_stopped[slot_name] = True

    info(f"  Borrowing {device} (reserve → serve → contract)...")
    rc, _res = do_reserve(res_devices, f"freetoken:{args.profile}",
                          int(profile.get("reserve_timeout", 3600)),
                          extra_stopped=extra_stopped)
    if rc != 0:
        _release_load_lock()
        return rc

    info(f"  Starting FreeToken on {device} (up to {timeout}s to ready)...")
    pid, cmd = start_server(profile, cuda_devices=cuda_dev, log_file=FT_LOG_FILE)
    verbose(f"  PID: {pid}")

    # Readiness = a real completion, not /health (see _ft_serving): the frontend
    # binds seconds before the engine finishes loading weights, and an engine that
    # dies after that point would otherwise be published to the contract as ready.
    healthy, elapsed, reason = _ft_wait_ready(pid, port, served_name, timeout)
    if not healthy:
        error(f"FreeToken failed to serve a completion after {elapsed}s ({reason})")
        if FT_LOG_FILE.exists():
            try:
                with open(FT_LOG_FILE) as f:
                    for line in f.readlines()[-20:]:
                        info(f"  {line.rstrip()}")
            except Exception:
                pass
        # Return the card: kill whatever is left, release restores the snapshot.
        # The load lock MUST be dropped first — do_release's primary restore takes
        # the same lock, so releasing it afterwards made every failed borrow
        # print "Load in progress — skipping <primary> restore" and leave the card
        # empty instead of putting llama back.
        _ft_stop(pid)
        _ft_wait_vram_free(device)  # or the restore below races the teardown
        _release_load_lock()
        do_release(no_restore=False)
        return 3

    _ft_save_state(args.profile, profile["model"], served_name, pid, port, device)
    write_contract()
    _release_load_lock()

    if _json_mode:
        json_out({"status": "loaded", "profile": args.profile, "backend": "freetoken",
                  "model": served_name, "pid": pid, "port": port, "device": device,
                  "ready_s": elapsed})
    else:
        info(f"\n  Loaded: {served_name} (FreeToken on {device}, port {port})")
        info(f"  PID: {pid}")
        info(f"  Ready in {elapsed}s — gateway routes '{served_name}' → 127.0.0.1:{port}")
        info(f"  Stop + return card: model-swap stop")
    return 0


def cmd_load(args):
    # An interrupt (Ctrl-C during the VRAM wait) or a crash skips the return
    # paths that drop the lock and re-publish; without this the contract keeps
    # `primary.state: loading` and a yielding consumer stays parked indefinitely.
    try:
        return _cmd_load(args)
    except BaseException:
        if (_read_load_lock() or {}).get("pid") == os.getpid():
            _release_load_lock()
            write_contract()
        raise


def _cmd_load(args):
    profile, err = load_profile(args.profile)
    if err:
        error(err)
        available = [n for n, _ in list_profiles()]
        if available:
            info(f"Available: {', '.join(available)}")
        return 4

    binary = resolve_binary(profile)
    if not binary or not binary.exists():
        default_bin = DS4_BIN_DEFAULT if _detect_backend(profile) == "ds4" else LLAMA_BIN_DEFAULT
        error(f"Binary not found: {profile.get('binary') or default_bin}")
        return 4

    model_path = resolve_model_path(profile)
    if not model_path:
        arc = archived_entry(profile["model"])
        if arc:
            error(f"Model is archived on {ARCHIVE_REMOTE}, not local: {profile['model']}")
            info(f"Restore: rclone copy {ARCHIVE_REMOTE}/{arc} {MODELS_DIR}/ --progress")
            return 4
        error(f"Model file not found: {profile['model']}")
        gguf_files = sorted(MODELS_DIR.glob("*.gguf"))
        if gguf_files:
            info("Available .gguf files:")
            for f in gguf_files:
                info(f"  {f.name} ({f.stat().st_size / 1e9:.1f}GB)")
        return 4

    backend = _detect_backend(profile)
    info(f"Loading profile: {args.profile}")
    info(f"  Backend: {backend}")
    info(f"  Model: {profile['model']}")
    info(f"  Description: {profile.get('description', '')}")

    # FreeToken borrows a card on its own port — different lifecycle
    # (reserve → serve → contract), so it never touches the 8012 path below.
    if backend == "freetoken":
        return _cmd_load_freetoken(args, profile)

    # GPU pre-flight
    ok, checks = gpu_preflight()
    for label, passed, msg in checks:
        verbose(f"  {label}: {'OK' if passed else 'FAIL'} — {msg}")
    if not ok:
        error("GPU pre-flight failed:")
        for label, passed, msg in checks:
            if not passed:
                error(f"  {label}: {msg}")
        return 2

    # Pool override: profile declares which GPU pool it needs
    pool_name = profile.get("pool")
    pool_slot = ALL_SLOTS.get(pool_name) if pool_name else None
    if pool_slot:
        info(f"  Pool: {pool_slot['gpu_label']}")

    # VRAM estimate — check against pool capacity when a pool is declared
    vram_needed = profile.get("vram_required_mb", 0)
    vram_cap = pool_slot["vram_mb"] if pool_slot else GPU_VRAM_TOTAL_MB
    if vram_needed > vram_cap:
        error(f"Profile needs {vram_needed}MiB but {'pool' if pool_slot else 'GPU'} only has {vram_cap}MiB total")
        return 5

    if args.dry_run:
        _, cmd = start_server(profile, dry_run=True, pool_slot=pool_slot)
        info(f"\n  Would run: {' '.join(cmd)}")
        return 0

    # Effective health timeout — needed now for the lock TTL, used again below.
    timeout = getattr(args, "timeout", 30)
    # vLLM model load is slow; bump the default (but honor an explicit override).
    # can't distinguish explicit --timeout 30 from the default 30, but
    # 30s would fail a vLLM load anyway, so bumping is the safe default.
    # Profile override is checked FIRST. It used to sit in the last elif, so for
    # vllm/ds4 the backend-default branch consumed the timeout==30 case and the
    # profile's health_timeout was dead code — qwen35-9b-fp16-vllm measures ~474s
    # to healthy and would still have been cut off at the 120s vllm default.
    if timeout == LLAMA_DEFAULT_TIMEOUT and profile.get("health_timeout"):
        timeout = int(profile["health_timeout"])
    elif backend == "vllm" and timeout == LLAMA_DEFAULT_TIMEOUT:
        timeout = VLLM_DEFAULT_TIMEOUT
    elif backend == "ds4" and timeout == LLAMA_DEFAULT_TIMEOUT:
        timeout = DS4_DEFAULT_TIMEOUT
    # (health_timeout is applied above, ahead of the backend defaults. A too-short
    # window returns failure while the server is still coming up — the process
    # then survives UNREGISTERED, since save_state is only reached on the success
    # path, so the contract keeps advertising the PREVIOUS profile. Downstream the
    # watchdog reaps the orphan under the old profile's idle policy and `ensure`
    # resurrects the old profile from .active.json.)
    max_attempts = 2

    # Load lock: refuse to fight a concurrent load (ensure racing a slow ds4
    # load would otherwise evict it mid-startup). Stale locks self-heal.
    # TTL covers the full worst case: all attempts + settle/report slack.
    if not _acquire_load_lock(args.profile, ttl_s=timeout * max_attempts + 300):
        lock = _read_load_lock() or {}
        error(f"Another load in progress (pid {lock.get('pid')}, profile "
              f"{lock.get('profile')}) — retry when it finishes")
        return 6

    # Free the primary card: evict any slot pool holding it before we claim it.
    _stop_slots_holding_primary()
    # Also stop any conflicting slot if we're claiming a pool
    if pool_slot:
        for sn, sl in ALL_SLOTS.items():
            slot_stop(sl)

    # FreeToken holds its card on its own port — don't stack a server on a
    # card it borrows (the reservation is the gateway's guard; this is ours).
    ft = _ft_state()
    if ft:
        ft_gpu = GPUS.get(str(ft.get("device")))
        ft_uuids = {ft_gpu["uuid"]} if ft_gpu else set()
        target_uuids = set(pool_slot["cuda_devices"].split(",")) if pool_slot else {GPU_UUID}
        if ft_uuids & target_uuids:
            error(f"FreeToken is borrowing {ft.get('device')} (PID {ft['pid']}, "
                  f"profile {ft.get('profile')}) — 'model-swap stop' first")
            return 3

    # Kill existing
    cur = get_current_state()
    if cur["running"]:
        info(f"  Stopping current server (PID {cur['pid']})...")
        killed, msg = kill_server(cur["pid"])
        verbose(msg)
        time.sleep(1)

    # Also gate against LIVE free VRAM, not just static total capacity — the
    # check above only catches a profile too big for the card period; it says
    # nothing about what's actually free right now (other processes, driver
    # overhead). A margin here catches a doomed launch before burning 30s+ on
    # a health-check timeout that turns out to be a CUDA OOM in disguise.
    # Runs AFTER killing any existing server (above) — checking before that
    # would false-positive on every ordinary swap, since the outgoing server
    # is still holding its VRAM at that point.
    if not pool_slot:
        _VRAM_SAFETY_MARGIN_MB = 300
        # Short VRAM is often a yielding consumer: publish `loading` (we hold the
        # load lock) so it can step aside, then give it time to free its VRAM.
        _VRAM_YIELD_WAIT_S = 45
        stats = get_gpu_stats()
        if stats and vram_needed > stats["vram_free_mb"] - _VRAM_SAFETY_MARGIN_MB:
            write_contract()
            info(f"  Waiting up to {_VRAM_YIELD_WAIT_S}s for VRAM ({stats['vram_free_mb']}MiB "
                 f"free, need {vram_needed}MiB) — waiting for other consumers to yield...")
            deadline = time.time() + _VRAM_YIELD_WAIT_S
            while time.time() < deadline:
                time.sleep(2)
                stats = get_gpu_stats() or stats
                if vram_needed <= stats["vram_free_mb"] - _VRAM_SAFETY_MARGIN_MB:
                    info(f"  VRAM free: {stats['vram_free_mb']}MiB")
                    break
        if stats and vram_needed > stats["vram_free_mb"] - _VRAM_SAFETY_MARGIN_MB:
            error(
                f"Profile estimates {vram_needed}MiB needed but only "
                f"{stats['vram_free_mb']}MiB is free right now (margin "
                f"{_VRAM_SAFETY_MARGIN_MB}MiB) after waiting {_VRAM_YIELD_WAIT_S}s — "
                f"refusing a likely-doomed launch. Stop whatever else is holding VRAM "
                f"(`model-swap ps` lists it), or lower ctx_size / drop "
                f"the MTP draft model on this profile, or re-run with a corrected "
                f"vram_required_mb if the estimate itself is stale."
            )
            _release_load_lock()
            write_contract()
            return 5

    # Start + health check, with one retry on process death (VRAM allocation crash)
    swap_start = time.time()
    for attempt in range(1, max_attempts + 1):
        if attempt > 1:
            # Re-verify lock ownership: an operator stop/reserve may have
            # deliberately taken over — don't resurrect the server under them.
            relock = _read_load_lock()
            if not relock or relock.get("pid") != os.getpid():
                error("Lost the load lock (stop/reserve intervened) — aborting retry")
                return 3
            info(f"  Retrying start (attempt {attempt}/{max_attempts})...")
            time.sleep(2)  # let VRAM settle after crash
        _refresh_load_lock()
        server_label = {"vllm": "vLLM", "ds4": "ds4-server"}.get(backend, "llama-server")
        info(f"  Starting {server_label}...")
        pid, cmd = start_server(profile, pool_slot=pool_slot)
        verbose(f"  PID: {pid}")

        info(f"  Waiting for health check (up to {timeout}s)...")
        healthy, elapsed, reason = wait_for_health(timeout_s=timeout, pid=pid)

        if healthy:
            break
        if reason == "process_died" and attempt < max_attempts:
            info(f"  Server crashed during startup ({elapsed}s) — will retry")
            continue
        # Final failure
        error(f"Health check failed after {elapsed}s ({reason})")
        if LOG_FILE.exists():
            info("\nLast 20 lines of log:")
            try:
                with open(LOG_FILE) as f:
                    lines = f.readlines()
                for line in lines[-20:]:
                    info(f"  {line.rstrip()}")
                # Surface the actual crash cause on stderr, not just a bare
                # "(timeout)"/"(process_died)" — grep the tail for known-fatal
                # patterns so an OOM etc. is visible even if only stderr is captured.
                _FATAL_PATTERNS = (
                    "cudaMalloc failed", "out of memory", "failed to allocate",
                    "failed to create", "CUDA error",
                )
                fatal_lines = [l.rstrip() for l in lines if any(p in l for p in _FATAL_PATTERNS)]
                if fatal_lines:
                    error(f"Likely cause: {fatal_lines[-1]}")
            except Exception:
                pass
        stats = get_gpu_stats()
        if stats:
            info(f"\nGPU: {stats['vram_used_mb']}MiB used, {stats['temperature_c']}°C")
        _release_load_lock()
        write_contract()
        return 3

    # Confirm model
    model_info = get_server_model_info()
    actual_model = model_info["id"] if model_info else "unknown"
    meta = model_info.get("meta", {}) if model_info else {}
    ctx_train = meta.get("n_ctx_train")
    # .active.json ctx_size is the served context; n_ctx_train only when unset
    # (llama-server then defaults to the model's trained context).
    ctx_size = profile.get("params", {}).get("ctx_size") or ctx_train

    # Save state
    save_state(args.profile, profile["model"], pid, ctx_size, backend=backend)
    if profile.get("kv_persist") and backend == "llama":
        _kv_restore(args.profile)

    # Report
    swap_time = round(time.time() - swap_start, 1)
    stats = get_gpu_stats()

    if _json_mode:
        json_out({
            "status": "loaded",
            "profile": args.profile,
            "model": actual_model,
            "pid": pid,
            "vram_used_mb": stats["vram_used_mb"] if stats else None,
            "swap_time_s": swap_time,
            "ctx_size": ctx_size,
        })
    else:
        info(f"\n  Loaded: {actual_model}")
        info(f"  Profile: {args.profile}")
        info(f"  PID: {pid}")
        if stats:
            info(f"  VRAM: {stats['vram_used_mb']}MiB / {stats['vram_total_mb']}MiB")
        if ctx_train:
            info(f"  Context (train): {ctx_train:,}")
        params = profile.get("params", {})
        if "ctx_size" in params:
            info(f"  Context (set): {params['ctx_size']:,}")
        info(f"  Swap time: {swap_time}s")

    # Start idle watchdog (kill any existing one first)
    # Profiles can set idle_stop: false to disable (slow models timeout mid-generation)
    if profile.get("idle_stop", True) and backend != "ds4":
        _restart_idle_watchdog()
    else:
        _kill_idle_watchdog()
        reason_txt = "ds4 has no /metrics" if backend == "ds4" else "profile"
        info(f"  Idle watchdog: disabled ({reason_txt})")

    _release_load_lock()
    return 0


def _kill_idle_watchdog():
    """Kill existing primary idle watchdog without restarting it."""
    try:
        result = subprocess.run(
            ["pgrep", "-f", "model-swap idle-stop"],
            capture_output=True, text=True,
        )
        for line in result.stdout.strip().splitlines():
            wpid = int(line.strip())
            if wpid != os.getpid():
                try:
                    os.kill(wpid, signal.SIGTERM)
                    verbose(f"Killed idle watchdog PID {wpid}")
                except ProcessLookupError:
                    pass
    except Exception:
        pass


def _restart_idle_watchdog(timeout_s=None, poll_s=None):
    """Kill existing idle watchdog if any, then fork a new one."""
    # Kill existing watchdog
    try:
        import subprocess as _sp
        result = _sp.run(
            ["pgrep", "-f", "model-swap idle-stop"],
            capture_output=True, text=True,
        )
        for line in result.stdout.strip().splitlines():
            wpid = int(line.strip())
            if wpid != os.getpid():
                try:
                    os.kill(wpid, signal.SIGTERM)
                    verbose(f"Killed old watchdog PID {wpid}")
                except ProcessLookupError:
                    pass
    except Exception:
        pass

    timeout_s = timeout_s or PRIMARY_IDLE_TIMEOUT_S
    poll_s = poll_s or PRIMARY_IDLE_POLL_S
    # Fork new watchdog
    child = os.fork()
    if child > 0:
        verbose(f"Idle watchdog started (PID {child}, {timeout_s}s timeout, {poll_s}s poll)")
        return
    # Child: close inherited pipe fds (critical when parent uses
    # subprocess.run(capture_output=True) — Python sys.stdout reassignment
    # doesn't close the underlying fd, keeping the pipe open and blocking
    # the parent's subprocess.run indefinitely).
    devnull_fd = os.open(os.devnull, os.O_RDWR)
    os.dup2(devnull_fd, 0)
    os.dup2(devnull_fd, 1)
    os.dup2(devnull_fd, 2)
    if devnull_fd > 2:
        os.close(devnull_fd)
    os.setsid()
    sys.stdout = open(os.devnull, "w")
    sys.stderr = open(os.devnull, "w")

    _primary_idle_loop(timeout_s, poll_s)
    os._exit(0)


def _kv_filename(profile_name):
    return f"{profile_name}.slot0.bin"


def _kv_post(action, profile_name, timeout_s):
    # slot 0 only; every kv_persist profile runs --parallel 1.
    req = Request(f"http://{HOST}:{PORT}/slots/0?action={action}",
                  data=json.dumps({"filename": _kv_filename(profile_name)}).encode(),
                  headers={"Content-Type": "application/json"})
    with urlopen(req, timeout=timeout_s) as r:
        return json.load(r)


def _kv_save(profile_name):
    """Snapshot slot 0's KV cache before an idle-stop (kv_persist profiles only).
    Best effort: a failed save just means the next turn re-prefills."""
    prof = load_profile(profile_name)[0] if profile_name else None
    if not (prof and prof.get("kv_persist")):
        return
    try:
        res = _kv_post("save", profile_name, 300)
        msg = (f"[kv] saved {res.get('n_saved')} tokens, {res.get('n_written', 0) >> 20} MiB "
               f"in {res.get('timings', {}).get('save_ms', 0):.0f} ms")
    except Exception as e:
        msg = f"[kv] save failed: {e}"
    try:
        with open(LOG_FILE, "a") as f:
            f.write(msg + "\n")
    except Exception:
        pass


def _kv_restore(profile_name):
    """Restore the idle-stop snapshot into slot 0, then delete it (one-shot, so a
    stale snapshot never outlives one load)."""
    path = KV_SAVE_DIR / _kv_filename(profile_name)
    if not path.exists():
        return
    try:
        res = _kv_post("restore", profile_name, 300)
        info(f"  KV restored: {res.get('n_restored')} tokens in "
             f"{res.get('timings', {}).get('restore_ms', 0):.0f} ms")
    except Exception as e:
        info(f"  KV restore failed ({e}); next request re-prefills")
    finally:
        path.unlink(missing_ok=True)


def _primary_idle_loop(timeout_s, poll_s):
    """Stop the primary after timeout_s with no new tokens. Shared by the
    load-time watchdog and `idle-stop`.

    Watches one server pid and exits when it changes, so a watchdog orphaned by
    a reload never stops its successor. A live lease on the card counts as
    activity. .active.json is kept: the gateway's wake-on-request `ensure`
    resolves it first, so the next call reloads the same profile (a dead pid
    in it never reads as running)."""
    watched, _ = find_server_process()
    if watched is None:
        return
    last_tokens = _get_predicted_total()
    last_activity = time.time()
    while True:
        time.sleep(poll_s)
        spid, _ = find_server_process()
        if spid != watched:
            verbose("Server gone or replaced, watchdog exiting.")
            return
        current_tokens = _get_predicted_total()
        if current_tokens is None:
            verbose("Can't reach metrics, skipping poll.")
            continue
        if current_tokens != last_tokens:
            last_tokens, last_activity = current_tokens, time.time()
            continue
        idle_s = time.time() - last_activity
        verbose(f"Idle: {idle_s:.0f}s / {timeout_s}s")
        if idle_s < timeout_s:
            continue
        if _lease_covers({"cuda_devices": GPU_UUID}):
            verbose(f"{PRIMARY_GPU} leased — deferring idle-stop")
            continue
        try:
            with open(LOG_FILE, "a") as f:
                f.write(f"\n[idle-stop] Auto-shutdown after {timeout_s}s idle at {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
        except Exception:
            pass
        info(f"Server idle for {timeout_s}s — stopping.")
        _kv_save((_read_state_file() or {}).get("profile"))
        kill_server(spid)
        try:
            write_contract()
        except Exception:
            pass
        return


def cmd_stop(args):
    # Handle --device <secondary alias>
    device = getattr(args, "device", None)
    if device == SECONDARY_ALIAS:
        return cmd_secondary_stop(args)

    # A concurrent load owns the primary right now — its retry loop would just
    # resurrect whatever we kill. Refuse; the operator can wait or re-run.
    lock = _read_load_lock()
    if lock and lock.get("pid") != os.getpid():
        error(f"Load in progress (pid {lock['pid']}, profile {lock.get('profile')}) "
              f"— wait for it, or remove {LOAD_LOCK} to force")
        return 6

    # FreeToken borrow: SIGTERM ft, then release with restore — the card goes
    # back to its snapshotted profile.
    ft = _ft_state()
    if ft:
        info(f"Stopping FreeToken (PID {ft['pid']}, port {ft['port']}, {ft.get('device')})...")
        killed, msg = _ft_stop(ft["pid"])
        info(f"  {msg}")
        freed, used_mb = _ft_wait_vram_free(ft.get("device"))
        if not freed:
            error(f"  {ft.get('device')} still holds {used_mb}MiB after 90s — "
                  f"restore may fail; check for an orphan process")
        else:
            verbose(f"  VRAM reclaimed on {ft.get('device')} ({used_mb}MiB)")
        FT_STATE_FILE.unlink(missing_ok=True)
        write_contract()
        if _json_mode:
            json_out({"status": "stopped", "backend": "freetoken",
                      "pid": ft["pid"], "message": msg})
        rc, _restored = do_release(no_restore=False)
        return rc  # do_release returns (rc, restored) — never leak the tuple

    # A FreeToken borrow whose engine already crashed: _ft_state() is None (dead
    # pid), so the branch above cannot fire, but the reservation it took is still
    # holding the card. Without this, `stop` printed "No server running", exited
    # 0, and left the GPU reserved until its TTL.
    _res = _read_reservation()
    if _res and str(_res.get("reason", "")).startswith("freetoken:"):
        info("FreeToken reservation without a live process (engine crashed) — "
             "returning the card")
        FT_STATE_FILE.unlink(missing_ok=True)
        rc, _restored = do_release(no_restore=False)
        return rc

    cur = get_current_state()
    if not cur["running"]:
        info("No server running")
        return 0

    info(f"Stopping {({'vllm': 'vLLM', 'ds4': 'ds4-server'}).get(cur.get('backend'), 'llama-server')} (PID {cur['pid']})...")
    killed, msg = kill_server(cur["pid"])
    info(f"  {msg}")

    write_contract()  # Update contract after stop

    if _json_mode:
        json_out({"status": "stopped", "pid": cur["pid"], "message": msg})
    return 0


def cmd_restart(args):
    cur = get_current_state()
    if not cur["profile"]:
        if cur["running"]:
            error("Server running but no profile matched — can't restart. Use 'load <profile>' instead.")
        else:
            error("No server running and no active profile to restart.")
        return 1

    args.profile = cur["profile"]
    return cmd_load(args)


def cmd_status(args):
    cur = get_current_state()
    healthy, health_text = check_health()
    stats = get_gpu_stats()
    model_info = get_server_model_info()

    # Refresh contract on every status check
    try:
        write_contract()
    except Exception:
        pass

    ft = _ft_state()

    if _json_mode:
        json_out({
            "server": {
                "running": cur["running"],
                "healthy": healthy,
                "pid": cur["pid"],
                "model": cur["model"],
                "profile": cur["profile"],
                "external": cur["external"],
            },
            "freetoken": ft,
            "model_info": model_info,
            "gpu": stats,
        })
        return 0

    if not cur["running"]:
        info("Server: stopped")
    else:
        status_label = "healthy" if healthy else "unhealthy"
        info(f"Server: running ({status_label})")
        info(f"  PID: {cur['pid']}")
