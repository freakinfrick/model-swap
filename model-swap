def cmd_validate(args):
    if args.profile:
        names = [args.profile]
    else:
        names = [n for n, _ in list_profiles()]

    all_ok = True
    for name in names:
        profile, err = load_profile(name)
        if err:
            error(f"{name}: {err}")
            all_ok = False
            continue

        issues = []
        backend = _detect_backend(profile)
        model_path = resolve_model_path(profile)

        vram = profile.get("vram_required_mb", 0)
        if vram > GPU_VRAM_TOTAL_MB:
            issues.append(f"VRAM required ({vram}MiB) exceeds GPU capacity ({GPU_VRAM_TOTAL_MB}MiB)")

        if backend == "vllm":
            # vLLM: model is an HF repo ID or local dir; binary is the venv python.
            if not VLLM_PYTHON.exists():
                issues.append(f"vLLM python not found: {VLLM_PYTHON}")
            m = profile["model"]
            if Path(m).is_absolute() and not Path(m).exists():
                issues.append(f"local model dir not found: {m}")
            for key in profile.get("params", {}):
                issues.append(f"llama 'params' block ignored for vllm backend (use vllm_params): {key}")
        elif backend == "ds4":
            if not model_path:
                issues.append(
                    f"model archived on {ARCHIVE_REMOTE} (restore via rclone): {profile['model']}"
                    if archived_entry(profile["model"])
                    else f"model file not found: {profile['model']}")
            binary = resolve_binary(profile)
            if not binary or not binary.exists():
                issues.append(f"ds4-server binary not found: {profile.get('binary') or DS4_BIN_DEFAULT}")
            for key in profile.get("ds4_params", {}):
                if key not in DS4_PARAM_MAP and key not in DS4_BOOL_FLAGS:
                    issues.append(f"unknown ds4_param '{key}' — won't be mapped to a flag")
            for key in profile.get("params", {}):
                issues.append(f"llama 'params' block ignored for ds4 backend (use ds4_params): {key}")
            if profile.get("idle_stop", True) is not False:
                issues.append("ds4 has no /metrics — the idle watchdog can never fire; "
                              "set 'idle_stop: false' explicitly")
        else:
            if not model_path:
                issues.append(
                    f"model archived on {ARCHIVE_REMOTE} (restore via rclone): {profile['model']}"
                    if archived_entry(profile["model"])
                    else f"model file not found: {profile['model']}")
            binary = resolve_binary(profile)
            if not binary or not binary.exists():
                issues.append(f"llama-server binary not found: {profile.get('binary') or LLAMA_BIN_DEFAULT}")
            for key in profile.get("params", {}):
                if key not in PARAM_MAP and key not in BOOL_FLAGS:
                    issues.append(f"unknown param '{key}' — won't be mapped to a flag")

        if _json_mode:
            json_out({"profile": name, "backend": backend, "valid": len(issues) == 0, "issues": issues})
        else:
            if issues:
                info(f"  {name} [{backend}]: INVALID")
                for issue in issues:
                    info(f"    - {issue}")
                all_ok = False
            else:
                size_info = ""
                # Only stat a real local file (llama GGUF, or a vLLM local dir).
                if model_path and model_path.exists() and model_path.is_file():
                    size_info = f" ({model_path.stat().st_size / 1e9:.1f}GB)"
                info(f"  {name} [{backend}]: OK{size_info}, VRAM {vram}MiB / {GPU_VRAM_TOTAL_MB}MiB")

    return 0 if all_ok else 1


def _get_predicted_total(port=None):
    """Read the generated-tokens counter from /metrics. Returns int or None.
    port: a slot's port (always llama); default the primary, backend from its state.

    Metric name differs by backend:
      llama.cpp -> llamacpp:tokens_predicted_total
      vLLM      -> vllm:generation_tokens_total
    """
    saved = None if port else _read_state_file()
    backend = saved.get("backend", "llama") if saved else "llama"
    if backend == "ds4":
        return None  # ds4-server exposes no /metrics; watchdog treats None as unknown
    metric_name = (
        "vllm:generation_tokens_total" if backend == "vllm"
        else "llamacpp:tokens_predicted_total"
    )
    try:
        req = Request(f"http://{HOST}:{port or PORT}/metrics")
        with urlopen(req, timeout=3) as resp:
            for line in resp.read().decode().splitlines():
                if line.startswith("#"):
                    continue
                if line.startswith(metric_name):
                    return int(float(line.split()[-1]))
    except Exception:
        pass
    return None


def cmd_idle_stop(args):
    """Monitor server activity and stop after idle timeout."""
    timeout_s = int(args.idle_minutes * 60) if args.idle_minutes else PRIMARY_IDLE_TIMEOUT_S
    poll_s = min(args.poll_seconds or PRIMARY_IDLE_POLL_S, timeout_s)

    pid, _ = find_server_process()
    if pid is None:
        info("No server running.")
        return 0

    if args.daemon:
        # Fork to background
        child = os.fork()
        if child > 0:
            info(f"Idle watchdog started (PID {child}), timeout={timeout_s}s, poll={poll_s}s")
            return 0
        # Child: detach
        os.setsid()
        sys.stdout = open(os.devnull, "w")
        sys.stderr = open(os.devnull, "w")

    info(f"Watching for idle (timeout={timeout_s}s, poll={poll_s}s)")
    _primary_idle_loop(timeout_s, poll_s)
    return 0


