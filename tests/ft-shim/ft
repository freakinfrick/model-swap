#!/usr/bin/env python3
"""Fake `ft` for the model-swap FreeToken backend lifecycle test (SPEC §5).

Mimics the real engine's observable surface: `serve` binds --port, serves
/health and /v1/models (served-model-name), prints the ready line, and exits
gracefully on SIGTERM — exactly what the backend relies on. `--version`
prints a shim marker. No GPU, no model load.
"""
import http.server
import json
import os
import socketserver
import signal
import sys


def main():
    args = sys.argv[1:]
    if "--version" in args:
        print("freetoken version 0.1.2-shim")
        return 0
    if args and args[0] == "serve":
        def opt(flag, default=None):
            return args[args.index(flag) + 1] if flag in args else default

        model = opt("--model", "shim/model")
        port = int(opt("--port", "1919"))
        served = opt("--served-model-name") or \
            model.rsplit("/", 1)[-1].removesuffix(".gguf")

        class Handler(http.server.BaseHTTPRequestHandler):
            def _send(self, obj):
                body = json.dumps(obj).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)

            def do_GET(self):
                if self.path == "/health":
                    self._send({"status": "ok"})
                elif self.path == "/v1/models":
                    self._send({"data": [{"id": served}]})
                else:
                    self.send_error(404)

            def do_POST(self):
                # FT_SHIM_DEAD_ENGINE=1 reproduces the real failure mode: the
                # HTTP frontend is up and /health is green, but the scheduler
                # process died, so completions 503. The load path must NOT call
                # this ready.
                if os.environ.get("FT_SHIM_DEAD_ENGINE") == "1":
                    self.send_error(503)
                    return
                # OpenAI-shaped chat completion so gateway :8088 round-trips work.
                if self.path == "/v1/chat/completions":
                    try:
                        req = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
                        echo = req.get("messages", [{"content": ""}])[-1].get("content", "")
                    except Exception:
                        req, echo = {}, ""
                    self._send({"id": "shim-1", "object": "chat.completion", "model": served,
                                "choices": [{"index": 0,
                                             "message": {"role": "assistant",
                                                         "content": f"FT-SHIM-OK echo={echo}"},
                                             "finish_reason": "stop"}],
                                "usage": {"prompt_tokens": 1, "completion_tokens": 1,
                                          "total_tokens": 2}})
                else:
                    self.send_error(404)

            def log_message(self, *a):  # quiet
                pass

        class Server(socketserver.TCPServer):
            allow_reuse_address = True

        srv = Server(("127.0.0.1", port), Handler)
        signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))
        sys.stderr.write(
            f"ft-shim: API server is ready to serve on 127.0.0.1:{port}\n")
        sys.stderr.flush()
        try:
            srv.serve_forever()
        finally:
            srv.server_close()
        return 0
    print("ft-shim: unknown invocation: " + " ".join(args), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
